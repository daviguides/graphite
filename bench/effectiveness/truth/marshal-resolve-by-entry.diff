+def resolve_task_yaml_for_entry(
+    task: TaskEntry,
+) -> Path | None:
+    """Resolve a task's task.yaml from its own project identity.
+
+    The recovery/death path helpers below (read_task_status,
+    reset_task_to_queued, mark_task_failed) used to funnel through
+    dao_cli's `resolve_task_yaml_path(name)`, which calls
+    `find_project_dir(start=None→cwd)` — that RAISES
+    FileNotFoundError whenever the caller's cwd isn't inside a
+    project source repo (the daemon runs from $HOME under launchd),
+    and the exceptions were silently swallowed. Net effect: the
+    entire stale-recovery + death-handling subsystem was a silent
+    no-op in daemon mode. This resolves from the TaskEntry's
+    (owner, repo, project) via the same externalized projects base
+    `resolve_source_root`/`_load_tasks_all_projects` already use —
+    zero dependency on cwd.
+
+    Falls back to dao_cli's cwd-based lookup only when the entry
+    carries no project identity (single-project scoped/interactive
+    mode, where cwd IS a valid signal — today's behavior for that
+    path, unchanged).
+
+    Args:
+        task: Task entry carrying name + project identity.
+
+    Returns:
+        Path to an existing task YAML, or None (with a loud
+        warning logged) if it can't be located.
+    """
+    from dao_cli.core.project import PROJECTS_BASE
+
+    if not (task.owner and task.repo and task.project):
+        try:
+            from dao_cli.core.project import (
+                resolve_task_yaml_path,
+            )
+
+            yaml_path = resolve_task_yaml_path(
+                task_name=task.name,
+                milestone=task.milestone,
+            )
+            if yaml_path.exists():
+                return yaml_path
+            logger.warning(
+                "Could not locate task.yaml for %s via cwd "
+                "detection (no owner/repo/project on entry) — "
+                "resolved path %s does not exist.",
+                task.name,
+                yaml_path,
+            )
+            return None
+        except Exception as e:
+            logger.warning(
+                "Could not resolve task.yaml for %s via cwd "
+                "detection (no owner/repo/project on entry): %s",
+                task.name,
+                e,
+            )
+            return None
+
+    # owner lowered to match dao_cli.core.registry._entry_dir's
+    # directory-naming convention (repo/project casing preserved);
+    # fall back to the owner as given for case-sensitive FSes.
+    project_dir: Path | None = None
+    for owner in (task.owner.lower(), task.owner):
+        candidate = PROJECTS_BASE / owner / task.repo / task.project
+        if candidate.is_dir():
+            project_dir = candidate
+            break
+    if project_dir is None:
+        logger.warning(
+            "Could not locate project dir for task %s "
+            "(%s/%s/%s under %s).",
+            task.name,
+            task.owner,
+            task.repo,
+            task.project,
+            PROJECTS_BASE,
+        )
+        return None
+
+    # Direct path first (cheap), then a glob fallback for entries
+    # whose YAML-declared milestone differs from the directory name
+    # (or standalone layouts the fields don't reflect).
+    task_dir = (
+        project_dir
+        / "initiatives"
+        / (task.initiative or "standalone")
+        / "milestones"
+        / (task.milestone or "standalone")
+        / "tasks"
+        / task.name
+    )
+    candidates = [
+        task_dir / "task.yaml",
+        task_dir / f"{task.name}.yaml",
+    ]
+    for scanned_dir in sorted(
+        project_dir.glob(
+            f"initiatives/*/milestones/*/tasks/{task.name}",
+        ),
+    ):
+        candidates.append(scanned_dir / "task.yaml")
+        candidates.append(scanned_dir / f"{task.name}.yaml")
+    for candidate in candidates:
+        if candidate.exists():
+            return candidate
+
+    logger.warning(
+        "Could not locate task.yaml for %s under %s.",
+        task.name,
+        project_dir,
+    )
+    return None
+

+        self, tmp_path: Path, monkeypatch,
+    ) -> None:
+        base = tmp_path / "projects"
+        entry, yaml_path = _identified_task_on_disk(
+            base,
+            name="pytest-marker-stale-recovery",
+            status="in_progress",
+            mode="IMPLEMENTING",
+        )
+        monkeypatch.setattr(
+            "dao_cli.core.project.PROJECTS_BASE", base,
+        )
+        monkeypatch.chdir(tmp_path)
+
+        # is_foreman_running is the REAL pgrep — no such process
+        # exists, so the task is genuinely stale.

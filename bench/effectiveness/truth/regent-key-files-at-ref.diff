+def _git(args: list[str], cwd: Path) -> subprocess.CompletedProcess[str] | None:
+    """Run one read-only git command; None when it could not run at all.
+
+    Never raises and never checks the return code: every caller here
+    treats a non-zero exit as "this repository does not answer that",
+    which is a different thing from an error worth propagating out of a
+    lint.
+    """
+    try:
+        return subprocess.run(
+            ["git", *args],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            timeout=15,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+def _out(args: list[str], cwd: Path) -> str | None:
+    """stdout of a successful read-only git command, else None."""
+    proc = _git(args, cwd)
+    if proc is None or proc.returncode != 0:
+        return None
+    return proc.stdout
+
+
+def _default_branch(root: Path) -> str | None:
+    """The repository's default branch, asked for rather than assumed.
+
+    A fourth copy of the fifteen lines that `worktree` and `instrument`
+    each keep, and deliberately so: regent depends on neither, and an
+    edge across two layers for this costs more than the duplication. It
+    is copied from their CURRENT shape, after the bug both carried —
+    returning "master" on any non-zero exit, so a missing remote, an
+    unfetched clone or a bad path all came back as a confident wrong
+    branch. Order of authority: the remote's own recorded HEAD, then
+    each candidate ref explicitly. A repository that answers for neither
+    is unknown, and unknown is None.
+
+    Args:
+        root: Repository root.
+
+    Returns:
+        The default branch name, or None when nothing answers.
+    """
+    head = _out(["symbolic-ref", "refs/remotes/origin/HEAD"], root)
+    if head and head.strip():
+        return head.strip().rsplit("/", 1)[-1]
+
+    for candidate in ("main", "master"):
+        if _out(["rev-parse", "--verify", f"origin/{candidate}"], root):
+            return candidate
+    return None
+
+
+def _umbrella_branch(
+    project_dir: Path, item_id: str
+) -> tuple[str | None, str]:
+    """The integration branch this run's work converges on, if any.
+
+    Returns (branch, ambiguity). A non-empty ambiguity means the briefs
+    disagree about where the work lands, and the caller must skip rather
+    than pick one — `check_base_branch_fallback` reports that
+    disagreement in its own voice; guessing here would add a second,
+    louder wrong answer on top of it.
+    """
+    briefs = brief_paths_by_type(
+        project_dir, item_id, "initiative"
+    ) + brief_paths_by_type(project_dir, item_id, "milestone")
+    declared = declared_base_branches(briefs)
+    if len(declared) > 1:
+        spread = ", ".join(sorted(declared))
+        return None, (
+            "the run's briefs declare different **Base Branch** values "
+            f"({spread}), so the branch its work converges on is not "
+            "decided — see the base_branch finding"
+        )
+    if len(declared) == 1:
+        return next(iter(declared)), ""
+    return None, ""
+
+
+def resolve_repo_tree(project_dir: Path, item_id: str) -> RepoTree:
+    """List the paths of the ref this run's work belongs to.
+
+    Which ref, and why. The honest answer for a closed run is the branch
+    the work converged on: the initiative's declared umbrella when there
+    is one, the repository's default branch otherwise. The umbrella is
+    tried first and the default is the fallback rather than a rival —
+    `instrument setup initiative` cuts the umbrella FROM the default, so
+    before it exists on origin the default is precisely the state the
+    run started from, not a guess about it.
+
+    Everything asked here is remote-tracking (`origin/...`) on purpose.
+    A local branch is the operator's, and the whole defect this replaces
+    was a check reading one machine's idea of the project.
+
+    No network call is made: the ref may be a fetch behind, and it is
+    allowed to be, because `check_key_files` also consults the working
+    copy and only reports a path missing from both.
+
+    Args:
+        project_dir: Project directory.
+        item_id: The signal being refined.
+
+    Returns:
+        A resolved RepoTree, or one carrying the reason it is not —
+        never an empty tree standing in for an unanswerable question.
+    """
+    config_path = project_dir / "project.yaml"
+    if not config_path.is_file():
+        return RepoTree(
+            unresolved=(
+                f"{config_path} does not exist, so no repository is "
+                "named to check declared paths against"
+            )
+        )
+    config = load_yaml(path=config_path)
+    raw_root = (config or {}).get("project", {}).get("source_root")
+    if not raw_root:
+        return RepoTree(
+            unresolved=(
+                "project.yaml records no source_root — the operator's "
+                "cwd is not a substitute, it is the bug this replaces"
+            )
+        )
+
+    source_root = Path(str(raw_root))
+    toplevel = _out(["rev-parse", "--show-toplevel"], source_root)
+    if not toplevel or not toplevel.strip():
+        return RepoTree(
+            unresolved=f"{source_root} is not a git checkout"
+        )
+    root = Path(toplevel.strip())
+    prefix = (_out(["rev-parse", "--show-prefix"], source_root) or "").strip()
+
+    umbrella, ambiguity = _umbrella_branch(project_dir, item_id)
+    if ambiguity:
+        return RepoTree(unresolved=ambiguity)
+
+    candidates = [f"origin/{umbrella}"] if umbrella else []
+    default = _default_branch(root)
+    if default:
+        candidates.append(f"origin/{default}")
+
+    for ref in candidates:
+        listing = _out(["ls-tree", "-r", "-t", "--name-only", "-z", ref], root)
+        if listing is None:
+            continue
+        return RepoTree(
+            ref=ref,
+            root=root,
+            prefix=prefix,
+            paths=frozenset(p for p in listing.split("\0") if p),
+        )
+
+    tried = ", ".join(candidates) if candidates else "none"
+    return RepoTree(
+        unresolved=(
+            f"no remote branch of {root} resolved (tried: {tried}) — "
+            "origin/HEAD is unset and origin/main, origin/master are "
+            "absent"
+        )
+    )
+

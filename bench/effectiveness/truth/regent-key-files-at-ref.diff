+def _known_to_repo(raw: str, tree: RepoTree) -> bool | None:
+    """Can this declared path be found? None when it is outside the repo.
+
+    Two sources are consulted, and a miss has to be a miss in BOTH.
+
+    The ref covers a closed run: its worktree is gone and its checkout
+    may sit any number of commits behind the branch the work merged to,
+    so the disk alone answers about a machine rather than about the
+    project. The working copy covers the opposite case: a run whose
+    tasks have not merged yet, where a file one task added and another
+    declares `Modify` exists locally and at no ref at all.
+
+    Neither kind of staleness can manufacture a "missing" on its own,
+    while the case this lint exists for — a brief naming a path that was
+    never real — is absent from both.
+
+    Args:
+        raw: The declared path, decoration already stripped.
+        tree: The resolved ref to look in.
+
+    Returns:
+        True when found, False when found in neither source, None when
+        the path lies outside the repository the ref belongs to.
+    """
+    if tree.root is None:
+        return None
+
+    path = Path(raw)
+    if path.is_absolute():
+        try:
+            candidates = [path.relative_to(tree.root).as_posix()]
+        except ValueError:
+            return None
+        on_disk = [path]
+    else:
+        # A relative declaration is read from the repository root, and
+        # then from the project's source root inside it — a brief for a
+        # monorepo subproject writes whichever its author had in mind,
+        # and guessing wrong would invent a missing file.

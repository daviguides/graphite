+@dataclass(frozen=True)
+class RepoTree:
+    """Every path one named git ref contains — the repository, not a disk.
+
+    `check_key_files` used to ask `Path(...).exists()`, which answers
+    about the operator's working copy: whatever branch it happens to sit
+    on, however many commits behind, with the task's worktree already
+    removed. Over the link-health run — six tasks delivered and merged —
+    that reported four files missing; they were in `main`, and the
+    checkout was eight commits behind. The check was never wrong; the
+    source it consulted was.
+
+    `paths` is repo-root-relative and holds trees as well as blobs, so a
+    brief that legitimately declares `tests/marks/fixtures/` is not told
+    its directory does not exist. `prefix` is the path from the
+    repository root down to the project's source root, for the briefs
+    that declare a path relative to the project rather than to the repo.
+
+    `unresolved` carries the reason nothing could be listed, and is empty
+    when the ref answered. An unresolved tree is never treated as an
+    empty repository — that would report every declared path missing,
+    which is the exact outcome this type exists to prevent.
+    """
+
+    ref: str = ""
+    root: Path | None = None
+    prefix: str = ""
+    paths: frozenset[str] = frozenset()
+    unresolved: str = ""
+
+    @property
+    def resolved(self) -> bool:
+        """Whether a named ref actually answered."""
+        return not self.unresolved and self.root is not None
+

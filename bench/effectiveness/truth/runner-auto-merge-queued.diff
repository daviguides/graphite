+class TestMergeCommandVerifiedAfterSuccess:
+    """WS1-T4: `gh pr merge --auto` exits 0 when it only ARMS the merge.
+    rc=0 is not a merge; the PR state is."""
+
+    def _run(self, tmp_path: Path, merged_states: list[bool]):
+        task_data = _base_task_data()
+        mock_cleanup = MagicMock(return_value=True)
+        mock_verify_umbrella = MagicMock(return_value=(True, "ok"))
+        calls: list[list[str]] = []
+
+        def _run_side_effect(cmd, **kwargs):
+            calls.append(cmd)
+            result = MagicMock()
+            result.returncode = 0
+            result.stdout = "OPEN" if cmd[:3] == ["gh", "pr", "view"] else ""
+            result.stderr = ""
+            return result
+
+        with (
+            patch(
+                "dao_cli.core.project.resolve_task_yaml_path",
+                return_value=Path("/fake/task.yaml"),
+            ),
+            patch(
+                "dao_cli.core.yaml_io.load_yaml",
+                return_value=task_data,
+            ),
+            patch("dao_cli.core.yaml_io.save_yaml", MagicMock()),
+            patch(
+                "runner.core.hooks.resolve_auth_env",
+                return_value={"GH_TOKEN": "t"},
+            ),
+            patch(
+                "runner.core.hooks._branch_has_commits",
+                return_value=True,
+            ),
+            patch(
+                "runner.core.hooks._work_already_in_base",
+                return_value=False,
+            ),
+            patch(
+                "runner.core.hooks._verify_pr_merged",
+                side_effect=merged_states,
+            ) as mock_verify,
+            patch(
+                "runner.core.hooks._resolve_project_scope",
+                return_value=None,
+            ),
+            patch(
+                "runner.core.hooks._compose_conventional_subject",
+                return_value="subject",
+            ),
+            patch(
+                "runner.core.hooks._compose_conventional_body",
+                return_value="body",
+            ),
+            patch(
+                "runner.core.hooks.verify_umbrella_after_merge",
+                mock_verify_umbrella,
+            ),
+            patch("runner.core.hooks._finalize_cleanup", mock_cleanup),
+            patch("runner.core.hooks.time.sleep"),
+            patch(
+                "runner.core.hooks.subprocess.run",
+                side_effect=_run_side_effect,
+            ),
+        ):
+            outcome = execute_finalizing(
+                cwd=tmp_path, task_name="regent-run-report-emission",
+            )
+        return outcome, mock_cleanup, mock_verify_umbrella, mock_verify, calls
+
+    def test_armed_auto_merge_is_auto_queued(self, tmp_path: Path) -> None:
+        # pre-merge check: not merged; post-merge polls: still not merged
+        outcome, cleanup, umbrella, verify, calls = self._run(
+            tmp_path, [False, False, False, False],
+        )
+        assert outcome.result == FinalizeResult.AUTO_QUEUED
+        assert not outcome.completed
+        cleanup.assert_not_called()
+        umbrella.assert_not_called()
+        assert not any(
+            c[:3] == ["gh", "api", "repos/{owner}/{repo}/git/refs/heads"]
+            for c in calls
+        )
+        # The post-merge check runs with the task's auth env.
+        assert verify.call_args.kwargs.get("env") == {"GH_TOKEN": "t"}
+
+    def test_merge_confirmed_proceeds(self, tmp_path: Path) -> None:
+        outcome, cleanup, umbrella, _, _ = self._run(
+            tmp_path, [False, True],
+        )
+        assert outcome.result == FinalizeResult.MERGED
+        umbrella.assert_called_once()
+        cleanup.assert_called_once()

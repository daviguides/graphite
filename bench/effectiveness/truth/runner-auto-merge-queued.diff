+def _verify_pr_merged(
+    pr_number: int | str,
+    env: dict[str, str] | None = None,
+) -> bool:
     """Check if a PR has been merged via gh CLI.
 
     Args:
         pr_number: PR number to check.
+        env: Auth env from `resolve_auth_env`; without it gh uses the
+            default account, which may not see the repo.
 
     Returns:
         True if the PR state is MERGED.
     """
     result = subprocess.run(
         ["gh", "pr", "view", str(pr_number), "--json", "state", "-q", ".state"],
+        env={**os.environ, **env} if env else None,
         capture_output=True,
         text=True,
+        timeout=30,
     )
     return result.returncode == 0 and result.stdout.strip() == "MERGED"
 
 
+# A plain squash merge reports MERGED immediately; the short poll only
+# absorbs GitHub's read-after-write lag, it does not wait for checks.
+_MERGE_CONFIRM_ATTEMPTS = 3
+_MERGE_CONFIRM_DELAY_S = 2.0
+
+
+def _merge_confirmed(
+    pr_number: int | str,
+    env: dict[str, str] | None,
+) -> bool:
+    """Whether a merge command that exited 0 actually merged the PR.
+
+    `gh pr merge --auto` exits 0 when it merely arms auto-merge
+    (required checks pending), and a merge queue accepts a PR without
+    merging it. Exit status is not the deliverable; PR state is.
+    """
+    for attempt in range(_MERGE_CONFIRM_ATTEMPTS):
+        if _verify_pr_merged(pr_number, env=env):
+            return True
+        if attempt < _MERGE_CONFIRM_ATTEMPTS - 1:
+            time.sleep(_MERGE_CONFIRM_DELAY_S)
+    return False
+
+

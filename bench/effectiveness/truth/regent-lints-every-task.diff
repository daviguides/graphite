+    def test_a_run_with_tasks_runs_the_per_task_lints(self, tmp_path) -> None:
+        """With task briefs on disk, the per-task lints stop skipping."""
+        _make_session(tmp_path)
+        brief = _brief(
+            tmp_path, "initiatives/c/m/ms1/tasks/t1/brief.md", "**Slug**: t1"
+        )
+        save_yaml(path=brief.parent / "task.yaml", data={"task": "t1"})
+        _write_briefs(
+            tmp_path, [{"type": "task", "name": "t1", "path": str(brief)}]
+        )
+
+        skipped = self._skipped_ids(build_lint_context(tmp_path, SESSION))
+
+        assert "slug_consistency" not in skipped
+        assert "delivery_verdict" not in skipped
+
+    def test_zero_resolved_tasks_never_reads_as_verified(
+        self, tmp_path
+    ) -> None:
+        """The expensive way to be wrong here is silence.
+
+        Once the per-task lints fan out, no finding means "every task
+        checked, all clean". If the resolver returns an empty list —
+        a manifest that named no tasks, a path that stopped
+        resolving — the checks produce nothing, and nothing is exactly
+        what a clean run looks like. So an empty list is a skip, and
+        the skip says which.
+        """
+        _make_session(tmp_path)
+        _write_briefs(tmp_path, [])
+
+        ctx = build_lint_context(tmp_path, SESSION)
+        findings = run_all_lints(ctx)
+
+        assert ctx.tasks == []
+        for lint_id in ("slug_consistency", "delivery_verdict"):
+            skip = next(
+                f
+                for f in findings
+                if f.lint_id == lint_id and f.message.startswith("skipped:")
+            )
+            assert "named none" in skip.message
 
     def test_dangling_finding_ref_is_now_caught(self, tmp_path) -> None:
         _make_session(tmp_path)

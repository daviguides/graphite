diff --git a/tools/orch/runner/tests/test_pr_base_boundary.py b/tools/orch/runner/tests/test_pr_base_boundary.py
new file mode 100644
index 0000000..ae7e094
--- /dev/null
+++ b/tools/orch/runner/tests/test_pr_base_boundary.py
@@ -0,0 +1,122 @@
+"""PR base is checked at the merge boundary (WS1-T7, B09)."""
+
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+from runner.core import hooks
+from runner.core.hooks import execute_finalizing, post_hook_validate_pr_target
+from runner.core.models import FinalizeResult
+
+
+def _proc(rc: int = 0, stdout: str = "", stderr: str = "") -> MagicMock:
+    return MagicMock(returncode=rc, stdout=stdout, stderr=stderr)
+
+
+class TestCheckPrBase:
+    def test_matching_umbrella_passes(self):
+        with patch.object(hooks, "_run_gh", return_value=_proc(0, "feat/x\n")):
+            assert hooks._check_pr_base(
+                7, {"base_branch": "feat/x"}, Path("/wt"), {},
+            ) is None
+
+    def test_mismatch_blocks(self):
+        with patch.object(hooks, "_run_gh", return_value=_proc(0, "main\n")):
+            out = hooks._check_pr_base(
+                7, {"base_branch": "feat/x"}, Path("/wt"), {},
+            )
+        assert out.result == FinalizeResult.MERGE_FAILED
+        assert "feat/x" in out.detail and "main" in out.detail
+
+    def test_no_umbrella_expects_default_branch(self):
+        with (
+            patch.object(hooks, "_default_base_ref", return_value="origin/main"),
+            patch.object(hooks, "_run_gh", return_value=_proc(0, "main\n")),
+        ):
+            assert hooks._check_pr_base(7, {}, Path("/wt"), {}) is None
+
+    def test_unknown_base_on_network_error_is_transient(self):
+        with patch.object(
+            hooks, "_run_gh",
+            return_value=_proc(1, stderr="error connecting to api.github.com"),
+        ):
+            out = hooks._check_pr_base(
+                7, {"base_branch": "feat/x"}, Path("/wt"), {},
+            )
+        assert out.result == FinalizeResult.TRANSIENT_FAILURE
+
+    def test_unknown_base_otherwise_fails_closed(self):
+        with patch.object(
+            hooks, "_run_gh", return_value=_proc(1, stderr="no pull requests"),
+        ):
+            out = hooks._check_pr_base(
+                7, {"base_branch": "feat/x"}, Path("/wt"), {},
+            )
+        assert out.result == FinalizeResult.MERGE_FAILED
+
+
+def test_execute_finalizing_never_merges_into_wrong_base(tmp_path):
+    task_data = {"pr": 7, "branch": "feature/t", "base_branch": "feat/x"}
+    calls: list[list[str]] = []
+
+    def fake_run(cmd, **kwargs):
+        calls.append(cmd)
+        if cmd[:3] == ["gh", "pr", "view"] and "baseRefName" in cmd:
+            return _proc(0, "main\n")
+        return _proc(0, "OPEN\n")
+
+    bind = MagicMock(return_value="a" * 40)
+    with (
+        patch(
+            "dao_cli.core.project.resolve_task_yaml_path",
+            return_value=Path("/fake/task.yaml"),
+        ),
+        patch("dao_cli.core.yaml_io.load_yaml", return_value=task_data),
+        patch("dao_cli.core.yaml_io.save_yaml", MagicMock()),
+        patch.object(hooks, "resolve_auth_env", return_value={}),
+        patch.object(hooks, "_branch_has_commits", return_value=True),
+        patch.object(hooks, "_verify_pr_merged", return_value=False),
+        patch.object(hooks, "_work_already_in_base", return_value=False),
+        patch.object(hooks, "_bind_merge_head", bind),
+        patch.object(hooks.subprocess, "run", side_effect=fake_run),
+    ):
+        out = execute_finalizing(cwd=tmp_path, task_name="t")
+
+    assert out.result == FinalizeResult.MERGE_FAILED
+    assert not any(c[:3] == ["gh", "pr", "merge"] for c in calls)
+    bind.assert_not_called()
+
+
+class TestValidatorTriState:
+    def _run(self, tmp_path, responses, task_data=None):
+        yaml_path = tmp_path / "task.yaml"
+        yaml_path.write_text("x: 1\n")
+        data = task_data or {"pr": 7, "base_branch": "feat/x"}
+        with (
+            patch(
+                "dao_cli.core.project.resolve_task_yaml_path",
+                return_value=yaml_path,
+            ),
+            patch("dao_cli.core.yaml_io.load_yaml", return_value=data),
+            patch.object(hooks, "resolve_auth_env", return_value={}),
+            patch.object(hooks.subprocess, "run", side_effect=responses),
+        ):
+            return post_hook_validate_pr_target("t", tmp_path)
+
+    def test_ok(self, tmp_path):
+        assert self._run(tmp_path, [_proc(0, "feat/x\n")]) == "ok"
+
+    def test_fixed(self, tmp_path):
+        assert self._run(
+            tmp_path, [_proc(0, "main\n"), _proc(0)],
+        ) == "fixed"
+
+    def test_mismatch_when_retarget_fails(self, tmp_path):
+        assert self._run(
+            tmp_path, [_proc(0, "main\n"), _proc(1, stderr="denied")],
+        ) == "mismatch"
+
+    def test_unknown_when_view_fails(self, tmp_path):
+        assert self._run(tmp_path, [_proc(1, stderr="boom")]) == "unknown"
+
+    def test_nothing_to_check_is_ok(self, tmp_path):
+        assert self._run(tmp_path, [], task_data={"pr": None}) == "ok"

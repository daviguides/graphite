-
-        parts = repo_slug.split("/", 1)
-        if len(parts) == 2:
-            owner, repo_name = parts
-        else:
-            owner, repo_name = "unknown", parts[0]
+    # Filter entries for this repo
+    repo_entries = [
+        e for e in raw
+        if isinstance(e, dict)
+        and e.get("repo") == repo_slug
+    ]
+    if not repo_entries:
+        return None
 
-        project_dir = (
-            _PROJECTS_BASE / owner.lower() / repo_name / entry["name"]
-        )
-        return project_dir / ".worktrees"
+    parts = repo_slug.split("/", 1)
+    if len(parts) == 2:
+        owner, repo_name = parts
+    else:
+        owner, repo_name = "unknown", parts[0]
+
+    # Determine CWD-relative path for monorepo matching
+    match_path = ""
+    if cwd:
+        try:
+            rel = cwd.resolve().relative_to(
+                source_path.resolve(),
+            )
+            match_path = str(rel) if str(rel) != "." else ""
+        except ValueError:
+            match_path = ""
+
+    # Walk up match_path for most-specific match
+    check = Path(match_path) if match_path else Path("")
+    while True:
+        check_str = str(check) if str(check) != "." else ""
+        for entry in repo_entries:
+            if entry.get("path", "") == check_str:
+                project_dir = (
+                    _PROJECTS_BASE
+                    / owner.lower()
+                    / repo_name
+                    / entry["name"]
+                )
+                return project_dir / ".worktrees"
+        if not check_str or check == Path(""):
+            break
+        check = check.parent
 
     return None
 

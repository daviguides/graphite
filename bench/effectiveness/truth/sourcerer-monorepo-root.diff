 ) -> Path | None:
     """Resolve externalized .worktrees from registry.
 
     Lightweight inline resolution — no dao_cli import.
+    For monorepos with multiple registry entries, uses
+    CWD relative path to match the most specific entry.
 
     Args:
-        source_path: Source project path to look up.
+        source_path: Source project path (git root).
+        cwd: Working directory for monorepo matching.
 
     Returns:
         Path to externalized .worktrees/, or None.
@@ -225,23 +235,48 @@ def _resolve_externalized_worktrees_root(
     if not repo_slug:
         return None
 
-    # Match against registry entries
-    for entry in raw:
-        if not isinstance(entry, dict):
-            continue
-        if entry.get("repo") != repo_slug:

@@ -0,0 +1,75 @@
+"""Tests for owner_publishes — the per-client forge opt-out."""
+
+import dao_cli.core.gh as gh_module
+from dao_cli.core.gh import owner_publishes
+from dao_cli.core.yaml_io import save_yaml
+
+
+def _owners(tmp_path, monkeypatch, data: dict) -> None:
+    """Point the module at a temporary owners.yaml."""
+    path = tmp_path / "owners.yaml"
+    save_yaml(path=path, data=data)
+    monkeypatch.setattr(gh_module, "OWNERS_DATA", path)
+
+
+class TestOwnerPublishes:
+    def test_absent_key_means_yes(self, tmp_path, monkeypatch):
+        """Silence keeps meaning what it meant before the key existed.
+
+        Every owner mapped before this property was added was being
+        published to; a new key must not retroactively mute anyone.
+        """
+        _owners(tmp_path, monkeypatch, {"acme": {"gh_account": "a"}})
+        assert owner_publishes("acme") is True
+
+    def test_explicit_false_means_no(self, tmp_path, monkeypatch):
+        _owners(
+            tmp_path,
+            monkeypatch,
+            {"acme": {"gh_account": "a", "publish": False}},
+        )
+        assert owner_publishes("acme") is False
+
+    def test_explicit_true_means_yes(self, tmp_path, monkeypatch):
+        _owners(
+            tmp_path,
+            monkeypatch,
+            {"acme": {"gh_account": "a", "publish": True}},
+        )
+        assert owner_publishes("acme") is True
+
+    def test_unmapped_owner_publishes(self, tmp_path, monkeypatch):
+        """Not being in the file is not an opt-out."""
+        _owners(tmp_path, monkeypatch, {"acme": {"publish": False}})
+        assert owner_publishes("other") is True
+
+    def test_unresolved_owner_publishes(self, tmp_path, monkeypatch):
+        """A caller that could not resolve an owner gets the default.
+
+        Silently declining to publish because the owner lookup failed
+        would look identical to a deliberate opt-out.
+        """
+        _owners(tmp_path, monkeypatch, {"acme": {"publish": False}})
+        assert owner_publishes(None) is True
+
+    def test_missing_file_publishes(self, tmp_path, monkeypatch):
+        monkeypatch.setattr(
+            gh_module, "OWNERS_DATA", tmp_path / "nope.yaml"
+        )
+        assert owner_publishes("acme") is True
+
+    def test_null_entry_publishes(self, tmp_path, monkeypatch):
+        """A key with no body parses as None, not an empty dict."""
+        _owners(tmp_path, monkeypatch, {"acme": None})
+        assert owner_publishes("acme") is True
+
+    def test_only_false_opts_out(self, tmp_path, monkeypatch):
+        """A truthy-but-wrong value is not read as an opt-out.
+
+        Only the literal `false` mutes an owner — a typo'd string
+        should not silently stop publishing a client's work.
+        """
+        _owners(
+            tmp_path, monkeypatch, {"acme": {"publish": "no"}}
+        )
+        assert owner_publishes("acme") is True

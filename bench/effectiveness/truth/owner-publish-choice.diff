+def owner_publishes(owner: str | None) -> bool:
+    """Whether this owner's work gets GitHub issues and board entries.
+
+    Publishing is per-owner because the decision is per-client, not
+    per-milestone: some clients want the work tracked on their board,
+    others deliberately want nothing on GitHub Issues.
+
+    Absent means yes. Every owner mapped before this property existed
+    was being published to, so silence has to keep meaning what it
+    meant — a new key must not retroactively mute anyone.
+
+    Args:
+        owner: GitHub owner name, or None when unresolved.
+
+    Returns:
+        True unless the owner explicitly opted out.
+    """
+    if not owner or not OWNERS_DATA.exists():
+        return True
+
+    from dao_cli.core.yaml_io import load_yaml
+
+    data = load_yaml(path=OWNERS_DATA)
+    owner_config = data.get(owner) or {}
+    return owner_config.get("publish", True) is not False
+
+

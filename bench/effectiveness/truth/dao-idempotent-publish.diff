+def _task_marker(task_name: str) -> str:
+    """Hidden marker tying a GitHub issue to the task that created it."""
+    return f"<!-- continuum-task: {task_name} -->"
+
+
+def _find_existing_issue(repo: str, task_name: str) -> int | None:
+    """Oldest issue whose body carries this task's marker, if any.
+
+    Reads the list API rather than search: search is indexed with a
+    lag, and the retry that most needs this runs seconds after the
+    issue was created.
+    """
+    from dao_cli.core.gh import _clean_env
+
+    marker = _task_marker(task_name)
+    try:
+        result = subprocess.run(
+            [
+                "gh", "issue", "list",
+                "--repo", repo,
+                "--state", "all",
+                "--limit", "300",
+                "--json", "number,body",
+            ],
+            capture_output=True,
+            text=True,
+            timeout=30,
+            env=_clean_env(),
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    if result.returncode != 0:
+        return None
+    try:
+        issues = json.loads(result.stdout or "[]")
+    except json.JSONDecodeError:
+        return None
+    matches = [
+        i["number"] for i in issues if marker in (i.get("body") or "")
+    ]
+    return min(matches) if matches else None
+
+
+def _acquire_publish_lock(yaml_path: Path):
+    """Exclusive per-task lock, held across check-then-create.
+
+    Two instrument runs over the same milestone each read a task with
+    no issue and each created one. The lock lives outside the projects
+    tree so it never shows up as a file to commit.
+    """
+    import fcntl
+    import hashlib
+
+    lock_dir = Path.home() / ".cache" / "dao-publish"
+    lock_dir.mkdir(parents=True, exist_ok=True)
+    digest = hashlib.sha256(str(yaml_path.resolve()).encode()).hexdigest()
+    fh = open(lock_dir / f"{digest[:16]}.lock", "w")
+    fcntl.flock(fh, fcntl.LOCK_EX)
+    return fh
+
+

diff --git a/tools/orch/dao-cli/tests/dao_cli/test_publish_idempotency.py b/tools/orch/dao-cli/tests/dao_cli/test_publish_idempotency.py
new file mode 100644
index 0000000..3a4b96e
--- /dev/null
+++ b/tools/orch/dao-cli/tests/dao_cli/test_publish_idempotency.py
@@ -0,0 +1,156 @@
+"""Issue creation must not duplicate across retries or concurrent runs.
+
+Two instrument processes set up the same milestone at once and each
+created every issue; a retry loop elsewhere created one task's issue
+thirty times. The marker in the issue body is what lets a later run
+find the issue an earlier run created but never recorded.
+"""
+
+from contextlib import ExitStack
+from unittest.mock import patch
+
+import pytest
+
+from dao_cli.core.yaml_io import load_yaml, save_yaml
+from dao_cli.task import _task_marker, publish_task
+
+
+@pytest.fixture()
+def task_yaml(tmp_path):
+    path = tmp_path / "task.yaml"
+    save_yaml(
+        path=path,
+        data={
+            "task": "t1-demo",
+            "summary": "Demo task",
+            "issue": None,
+            "item_ids": None,
+        },
+    )
+    return path
+
+
+def _patches(task_yaml):
+    return [
+        patch("dao_cli.task.resolve_task_yaml_path", return_value=task_yaml),
+        patch("dao_cli.task.resolve_repo", return_value="user/repo"),
+        patch("dao_cli.task.resolve_owner", return_value="user"),
+        patch("dao_cli.task.ensure_gh_auth"),
+        patch(
+            "dao_cli.core.project.resolve_board_numbers",
+            return_value=[2],
+        ),
+        patch("dao_cli.core.project.resolve_gh_account", return_value="u"),
+        patch("dao_cli.board.set_board_priority"),
+        patch("dao_cli.board.set_board_size"),
+    ]
+
+
+def _run(task_yaml, extra):
+    with ExitStack() as stack:
+        for p in _patches(task_yaml) + extra:
+            stack.enter_context(p)
+        return publish_task("t1-demo", milestone=None)
+
+
+def test_marker_is_in_created_issue_body(task_yaml):
+    with patch(
+        "dao_cli.board.create_and_track_issue",
+        return_value=(42, "https://github.com/user/repo/issues/42", {2: "X"}),
+    ) as create:
+        _run(
+            task_yaml,
+            [patch("dao_cli.task._find_existing_issue", return_value=None)],
+        )
+    assert _task_marker("t1-demo") in create.call_args.kwargs["body"]
+    assert load_yaml(path=task_yaml)["issue"] == 42
+
+
+def test_failure_after_creation_then_rerun_reuses_issue(task_yaml):
+    """The issue is created, then the call dies before the number is
+    saved. The rerun must adopt that issue, not open a second one."""
+    with (
+        patch(
+            "dao_cli.board.create_and_track_issue",
+            side_effect=RuntimeError("killed after gh issue create"),
+        ) as create,
+        patch("dao_cli.task._find_existing_issue", return_value=None),
+        pytest.raises(RuntimeError),
+    ):
+        _run(task_yaml, [])
+    assert create.call_count == 1
+    assert not load_yaml(path=task_yaml).get("issue")
+
+    with (
+        patch("dao_cli.board.create_and_track_issue") as create_again,
+        patch("dao_cli.core.github.add_to_board", return_value="PVTI_1"),
+    ):
+        outcome = _run(
+            task_yaml,
+            [patch("dao_cli.task._find_existing_issue", return_value=77)],
+        )
+    create_again.assert_not_called()
+    assert outcome.issue_number == 77
+    assert load_yaml(path=task_yaml)["issue"] == 77
+
+
+def test_existing_marked_issue_is_reused(task_yaml):
+    with (
+        patch("dao_cli.board.create_and_track_issue") as create,
+        patch("dao_cli.core.github.add_to_board", return_value="PVTI_1"),
+    ):
+        _run(
+            task_yaml,
+            [patch("dao_cli.task._find_existing_issue", return_value=501)],
+        )
+    create.assert_not_called()
+    data = load_yaml(path=task_yaml)
+    assert data["issue"] == 501
+    assert data["item_ids"] == {2: "PVTI_1"}
+
+
+def test_null_item_ids_does_not_crash(task_yaml):
+    """`item_ids: null` in YAML used to hit `None[bn] = iid`."""
+    data = load_yaml(path=task_yaml)
+    data["issue"] = 9
+    data["item_ids"] = None
+    save_yaml(path=task_yaml, data=data)
+    with patch("dao_cli.core.github.add_to_board", return_value="PVTI_9"):
+        _run(task_yaml, [])
+    assert load_yaml(path=task_yaml)["item_ids"] == {2: "PVTI_9"}
+
+
+def test_unparsable_issue_number_is_resolved_by_marker(task_yaml):
+    """gh returned no URL → number 0. Persisting 0 means "unpublished"
+    and the next run creates it again."""
+    with patch(
+        "dao_cli.board.create_and_track_issue",
+        return_value=(0, "weird output", {2: "X"}),
+    ):
+        _run(
+            task_yaml,
+            [
+                patch(
+                    "dao_cli.task._find_existing_issue",
+                    side_effect=[None, 88],
+                )
+            ],
+        )
+    assert load_yaml(path=task_yaml)["issue"] == 88
+
+
+def test_find_existing_issue_picks_oldest_exact_marker():
+    from dao_cli import task as task_mod
+
+    payload = (
+        '[{"number": 12, "body": "x <!-- continuum-task: t1-demo -->"},'
+        ' {"number": 9, "body": "<!-- continuum-task: t1-demo -->"},'
+        ' {"number": 5, "body": "<!-- continuum-task: t1-demo-2 -->"}]'
+    )
+
+    class R:
+        returncode = 0
+        stdout = payload
+
+    with patch.object(task_mod.subprocess, "run", return_value=R()):
+        assert task_mod._find_existing_issue("user/repo", "t1-demo") == 9

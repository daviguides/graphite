diff --git a/tools/orch/instrument/tests/test_setup_concurrent_milestone.py b/tools/orch/instrument/tests/test_setup_concurrent_milestone.py
new file mode 100644
index 0000000..4ee6d2a
--- /dev/null
+++ b/tools/orch/instrument/tests/test_setup_concurrent_milestone.py
@@ -0,0 +1,74 @@
+"""A second setup of the same milestone writes milestone.yaml mid-run.
+
+Seen on runner-v2 m6: an initiative-level setup and a single-milestone
+setup ran at once. The single run found no milestone.yaml, the other
+wrote it before this run reached the create step, so this run skipped
+creation and carried `ms_data = None` to the final save:
+`'NoneType' object does not support item assignment`.
+"""
+
+import asyncio
+from pathlib import Path
+from unittest.mock import AsyncMock, patch
+
+import yaml
+from continuum_core.events import EventEmitter
+from continuum_core.models import TaskBreakdownItem
+
+from instrument.core.milestone import setup_milestone
+
+MS = "race-ms"
+INIT = "standalone"
+
+
+def _ms_dir(root: Path) -> Path:
+    return root / "initiatives" / INIT / "milestones" / MS
+
+
+def test_milestone_yaml_written_mid_run_does_not_crash(tmp_path: Path):
+    ms_dir = _ms_dir(tmp_path)
+    (ms_dir / "tasks" / "t1-a").mkdir(parents=True)
+    (ms_dir / "brief.md").write_text("# Milestone: Race\n", encoding="utf-8")
+    (ms_dir / "tasks" / "t1-a" / "brief.md").write_text(
+        "# Task: t1-a\n", encoding="utf-8"
+    )
+    ms_yaml = ms_dir / "milestone.yaml"
+
+    async def other_process_writes_milestone(*_args, **_kwargs):
+        ms_yaml.write_text(
+            yaml.safe_dump(
+                {"milestone": MS, "workflow": "self-implementation",
+                 "tasks": []}
+            ),
+            encoding="utf-8",
+        )
+        return (
+            {"goal": "g", "workflow": "self-implementation"},
+            [TaskBreakdownItem(name="t1-a", summary="s")],
+        )
+
+    with (
+        patch(
+            "dao_cli.core.project.find_project_dir",
+            return_value=tmp_path,
+        ),
+        patch(
+            "instrument.core.milestone._extract_breakdown_via_sdk",
+            new=AsyncMock(side_effect=other_process_writes_milestone),
+        ),
+        patch("instrument.core.milestone._publish_task"),
+        patch(
+            "continuum_core.github.resolve_auth_env", return_value=None
+        ),
+    ):
+        items = asyncio.run(
+            setup_milestone(
+                name=MS,
+                emitter=EventEmitter(task_name=MS),
+            )
+        )
+
+    assert [i.name for i in items] == ["t1-a"]
+    saved = yaml.safe_load(ms_yaml.read_text(encoding="utf-8"))
+    assert saved["milestone"] == MS
+    assert [t["name"] for t in saved["tasks"]] == ["t1-a"]

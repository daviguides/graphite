+class TestTheDiffIsTakenFromItsOwnMerge:
+    """A merge N commits behind the tip still scores off its own merge.
+
+    The 2026-08-11 14:09Z run of idea-have-bookmarks-three-8fa2 scored
+    four merged, approved, on-main tasks as `delivered-nothing` and
+    printed "4 task(s) publish 'done' against the evidence". Every one
+    of them was on main. Two defects stacked:
+
+    the pinned tip was only ever fetched when it happened to BE some
+    task's merge commit, so for every task checked before that one
+    `git merge-base --is-ancestor` was asked about an object git did not
+    have; and it answers that with exit 128, which this module read as
+    the exit-1 "no". The single task that scored `delivered` was the one
+    whose own merge commit was the tip.
+    """
+
+    def test_the_tip_is_fetched_once_before_any_task_is_scored(
+        self, recorder, tmp_path
+    ):
+        _signal(
+            tmp_path,
+            tasks=[{"name": "t1"}, {"name": "t2"}, {"name": "t3"}],
+        )
+        rec = recorder(have=False)
+        delivery.score_signal(tmp_path, "idea-x", source_dir=tmp_path)
+
+        # The tip is ensured before the first PR is even queried, so no
+        # task's answer depends on another task having fetched it.
+        first_gh = next(
+            i for i, c in enumerate(rec.calls) if c[0] == "gh"
+        )
+        tip_fetches = [
+            i
+            for i, c in enumerate(rec.calls)
+            if c[0] == "git" and c[1] == "fetch" and REMOTE_SHA in c
+        ]
+        assert tip_fetches and tip_fetches[0] < first_gh
+
+    def test_an_ancestry_error_is_a_skip_not_delivered_nothing(
+        self, recorder, tmp_path
+    ):
+        """Exit 128 is git failing to answer, not git answering no."""
+        _signal(tmp_path, tasks=[{"name": "t1"}])
+        recorder(ancestor_code=128)
+        board = delivery.score_signal(
+            tmp_path, "idea-x", source_dir=tmp_path
+        )
+        score = board.scores[0]
+
+        assert score.verdict is Verdict.COULD_NOT_READ
+        assert board.count(Verdict.NOTHING) == 0
+        assert "could not be computed" in score.detail
+
+    def test_only_exit_one_means_not_reachable(self, recorder, tmp_path):
+        _signal(tmp_path, tasks=[{"name": "t1"}])
+        recorder(ancestor_code=1)
+        board = delivery.score_signal(
+            tmp_path, "idea-x", source_dir=tmp_path
+        )
+        assert board.scores[0].verdict is Verdict.NOTHING
+
+    def test_a_task_behind_the_tip_still_scores_off_its_own_merge(
+        self, recorder, tmp_path
+    ):
+        """The whole bug, end to end.
+
+        Five tasks, all merged and reachable; only the last one's merge
+        commit equals the tip. Before the fix the first four errored
+        their ancestry call and read `delivered-nothing`.
+        """
+        _signal(
+            tmp_path,
+            tasks=[{"name": f"t1-{n}"} for n in range(1, 6)],
+        )
+        recorder()
+        board = delivery.score_signal(
+            tmp_path, "idea-x", source_dir=tmp_path
+        )
+
+        assert [s.verdict for s in board.scores] == [Verdict.DELIVERED] * 5
+        assert board.count(Verdict.NOTHING) == 0
+
+    def test_the_diff_is_against_the_first_parent_not_the_tip(
+        self, recorder, tmp_path
+    ):
+        """Pinning the read is not the same as diffing against the pin."""
+        _signal(tmp_path, tasks=[{"name": "t1"}])
+        rec = recorder()
+        delivery.score_signal(tmp_path, "idea-x", source_dir=tmp_path)
+
+        diffs = [
+            c for c in rec.git_calls if c[1] == "diff" and "--numstat" in c
+        ]
+        assert diffs, "the merge's own diff was never computed"
+        assert diffs[0][-2:] == [PARENT_SHA, MERGE_SHA]
+        # The tip is what the read is pinned to, never what it subtracts.
+        assert REMOTE_SHA not in diffs[0]
+
+    def test_git_show_is_never_used_on_a_merge(self, recorder, tmp_path):
+        """Its combined diff omits files unchanged from one parent."""
+        _signal(tmp_path, tasks=[{"name": "t1"}])
+        rec = recorder()
+        delivery.score_signal(tmp_path, "idea-x", source_dir=tmp_path)
+        assert not [c for c in rec.git_calls if c[1] == "show"]
+

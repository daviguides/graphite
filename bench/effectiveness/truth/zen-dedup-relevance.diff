index 0000000..3874b1b
--- /dev/null
+++ b/tools/context/zen-review/zen_review/orchestration/dedup.py
@@ -0,0 +1,233 @@
+"""Deterministic deduplication of review issues.
+
+Architecture
+------------
+Pure functions that merge duplicate findings reported by multiple
+reviewers at the same location (e.g. zen-reviewer and style-reviewer
+both flagging a mutable DTO on the same line).
+
+Responsibility
+--------------
+Single responsibility: Collapse duplicate issues.
+- Group by file and nearby line (±2 tolerance)
+- Detect duplicates via title token similarity (Jaccard >= 0.5)
+- Merge keeping highest severity, most specific title, and an
+  "Also flagged by" attribution note
+
+Context
+-------
+Called by the orchestrator after gathering all reviewer issues,
+BEFORE the relevance filter and summary counting.
+
+Boundaries
+----------
+DOES:
+- Merge same-finding duplicates across reviewers
+- Preserve distinct findings on the same line (e.g. missing auth
+  vs missing rate limiting on one endpoint)
+
+DOES NOT:
+- Judge relevance (relevance filter does that)
+- Talk to the SDK or any I/O — pure, fully testable
+"""
+
+import re
+from typing import Final
+
+# Runtime import kept for codebase consistency (models are imported
+# at runtime everywhere; no TYPE_CHECKING blocks in this project)
+from zen_review.models.review import ReviewIssue  # noqa: TC001
+
+# Line distance still considered "same location" (SSOT)
+LINE_TOLERANCE: Final[int] = 2
+
+# Minimum Jaccard similarity between title token sets to merge (SSOT)
+TITLE_SIMILARITY_THRESHOLD: Final[float] = 0.5
+
+# Tokens carrying no discriminating signal in issue titles
+_STOPWORDS: Final[frozenset[str]] = frozenset(
+    {
+        "a", "an", "the", "of", "in", "on", "for", "to", "is", "are",
+        "be", "should", "must", "not", "no", "missing", "instead",
+        "with", "and", "or", "does", "meet", "use", "uses", "using",
+        "has", "have", "lacks", "without",
+    }
+)
+
+_SEVERITY_RANK: Final[dict[str, int]] = {"HIGH": 3, "MEDIUM": 2, "LOW": 1}
+
+
+def dedupe_issues(issues: list[ReviewIssue]) -> list[ReviewIssue]:
+    """Collapse duplicate findings reported at the same location.
+
+    Responsibility
+    --------------
+    Merge issues that describe the SAME finding on the same file and
+    (near-)same line, keeping the strongest representative and
+    attributing the other reviewers.
+
+    Context
+    -------
+    Runs after all reviewers complete, before relevance filtering
+    and summary counting.
+
+    Args
+    ----
+    issues : list[ReviewIssue]
+        All issues from all reviewers.
+
+    Returns
+    -------
+    list[ReviewIssue]
+        Deduplicated issues, original order of first occurrence
+        preserved.
+
+    Examples
+    --------
+    >>> merged = dedupe_issues([zen_issue, style_duplicate])
+    >>> len(merged)
+    1
+    """
+    merged: list[ReviewIssue] = []
+
+    for issue in issues:
+        duplicate_of = _find_duplicate(issue, merged)
+        if duplicate_of is None:
+            merged.append(issue)
+            continue
+
+        index = merged.index(duplicate_of)
+        merged[index] = _merge_pair(duplicate_of, issue)
+
+    return merged
+
+
+def _find_duplicate(
+    issue: ReviewIssue,
+    accepted: list[ReviewIssue],
+) -> ReviewIssue | None:
+    """Find an already-accepted issue that is the same finding.
+
+    Args
+    ----
+    issue : ReviewIssue
+        Candidate issue.
+    accepted : list[ReviewIssue]
+        Issues accepted so far.
+
+    Returns
+    -------
+    ReviewIssue | None
+        The accepted issue this candidate duplicates, or None.
+    """
+    for existing in accepted:
+        if existing.file != issue.file:
+            continue
+        if abs(existing.line - issue.line) > LINE_TOLERANCE:
+            continue
+        if _title_similarity(existing, issue) >= TITLE_SIMILARITY_THRESHOLD:
+            return existing
+    return None
+
+
+def _title_similarity(first: ReviewIssue, second: ReviewIssue) -> float:
+    """Jaccard similarity between significant title tokens.
+
+    Filename-derived tokens are excluded — two DIFFERENT findings on
+    the same endpoint otherwise look similar just by naming the
+    endpoint ("...on Ticket Scan Endpoint").
+
+    Args
+    ----
+    first : ReviewIssue
+        First issue.
+    second : ReviewIssue
+        Second issue (same file as first).
+
+    Returns
+    -------
+    float
+        Jaccard similarity in [0, 1].
+    """
+    filename_tokens = _tokenize(first.file)
+
+    tokens_first = _tokenize(first.title) - filename_tokens
+    tokens_second = _tokenize(second.title) - filename_tokens
+
+    if not tokens_first or not tokens_second:
+        return 0.0
+
+    intersection = tokens_first & tokens_second
+    union = tokens_first | tokens_second
+    return len(intersection) / len(union)
+
+
+def _tokenize(text: str) -> set[str]:
+    """Extract significant lowercase tokens from text.
+
+    Splits camelCase/PascalCase (``TicketController`` → ``ticket``,
+    ``controller``) so filename-derived tokens actually match the
+    words reviewers use in titles.
+
+    Args
+    ----
+    text : str
+        Title or file path.
+
+    Returns
+    -------
+    set[str]
+        Alphanumeric tokens minus stopwords.
+    """
+    raw = re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|[0-9]+", text)
+    return {
+        token.lower() for token in raw if token.lower() not in _STOPWORDS
+    }
+
+
+def _merge_pair(kept: ReviewIssue, duplicate: ReviewIssue) -> ReviewIssue:
+    """Merge a duplicate into the kept issue.
+
+    Keeps the higher severity, the more specific title (more
+    significant tokens), the higher relevance, and appends an
+    attribution note listing the other reviewer.
+
+    Args
+    ----
+    kept : ReviewIssue
+        Issue accepted first.
+    duplicate : ReviewIssue
+        Newly detected duplicate.
+
+    Returns
+    -------
+    ReviewIssue
+        Merged issue.
+    """
+    stronger, weaker = kept, duplicate
+    if _SEVERITY_RANK[duplicate.severity] > _SEVERITY_RANK[kept.severity]:
+        stronger, weaker = duplicate, kept
+
+    title = stronger.title
+    if len(_tokenize(weaker.title)) > len(_tokenize(stronger.title)):
+        title = weaker.title
+
+    problem = stronger.problem
+    note = f"Also flagged by: {weaker.reviewer}"
+    if note not in problem:
+        problem = f"{problem}\n\n{note}"
+
+    return stronger.model_copy(
+        update={
+            "title": title,
+            "problem": problem,
+            "relevance": max(kept.relevance, duplicate.relevance),
+        }
+    )
+
+
+__all__ = [
+    "LINE_TOLERANCE",
+    "TITLE_SIMILARITY_THRESHOLD",
+    "dedupe_issues",
+]

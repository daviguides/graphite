+"""Tests for cross-reviewer deduplication and relevance filtering.
+
+Cases mirror the real PR#9 run (review-20260824-192036.yaml) where
+zen-reviewer and style-reviewer duplicated findings at the same
+file:line, and testing-reviewer produced low-relevance noise.
+"""
+
+from zen_review.models.review import ReviewIssue
+from zen_review.orchestration.dedup import dedupe_issues
+from zen_review.orchestration.orchestrator import Orchestrator
+
+
+def _issue(
+    file: str,
+    line: int,
+    title: str,
+    severity: str = "MEDIUM",
+    reviewer: str = "zen-reviewer",
+    category: str = "zen",
+    relevance: int = 3,
+) -> ReviewIssue:
+    """Build a synthetic issue for dedup tests."""
+    return ReviewIssue(
+        file=file,
+        line=line,
+        severity=severity,
+        category=category,
+        title=title,
+        problem="Problem description long enough",
+        impact="Impact description long enough",
+        reviewer=reviewer,
+        relevance=relevance,
+    )
+
+
+class TestDedupeIssues:
+    """Tests for dedupe_issues() on real-run shapes."""
+
+    def test_merges_same_finding_across_reviewers(self) -> None:
+        """pom.xml:21 Java version flagged by zen AND style → 1 issue."""
+        zen = _issue(
+            "pom.xml",
+            21,
+            "Java version does not meet LTS requirement",
+            severity="HIGH",
+            reviewer="zen-reviewer",
+        )
+        style = _issue(
+            "pom.xml",
+            21,
+            "Java version does not meet required LTS",
+            severity="MEDIUM",
+            reviewer="style-reviewer",
+            category="style",
+        )
+
+        merged = dedupe_issues([zen, style])
+
+        assert len(merged) == 1
+        assert merged[0].severity == "HIGH"
+        assert "Also flagged by: style-reviewer" in merged[0].problem
+
+    def test_merges_within_line_tolerance(self) -> None:
+        """Spotless/ErrorProne flagged at pom.xml:60 and :61 → merged."""
+        first = _issue(
+            "pom.xml",
+            60,
+            "Missing Spotless and Error Prone build plugins",
+            severity="HIGH",
+        )
+        second = _issue(
+            "pom.xml",
+            61,
+            "Spotless and Error Prone plugins absent from build",
+            reviewer="style-reviewer",
+            category="style",
+        )
+
+        merged = dedupe_issues([first, second])
+
+        assert len(merged) == 1
+
+    def test_record_finding_deduped_per_line_not_across_lines(self) -> None:
+        """OrderResponse record issues at :10 and :45 stay separate."""
+        outer_zen = _issue(
+            "src/main/java/dto/OrderResponse.java",
+            10,
+            "Mutable POJO instead of immutable record",
+        )
+        outer_style = _issue(
+            "src/main/java/dto/OrderResponse.java",
+            10,
+            "DTO should be immutable record",
+            reviewer="style-reviewer",
+            category="style",
+        )
+        nested = _issue(
+            "src/main/java/dto/OrderResponse.java",
+            45,
+            "Nested TicketResponse should be immutable record",
+        )
+
+        merged = dedupe_issues([outer_zen, outer_style, nested])
+
+        assert len(merged) == 2
+
+    def test_distinct_findings_on_same_line_not_merged(self) -> None:
+        """Auth vs rate-limit on TicketController:30 → both survive."""
+        auth = _issue(
+            "src/main/java/controller/TicketController.java",
+            30,
+            "Missing Authentication on Ticket Scan Endpoint",
+            severity="HIGH",
+            reviewer="security-reviewer",
+            category="security",
+        )
+        rate = _issue(
+            "src/main/java/controller/TicketController.java",
+            30,
+            "No Rate Limiting on Ticket Scan Endpoint",
+            reviewer="security-reviewer",
+            category="security",
+        )
+
+        merged = dedupe_issues([auth, rate])
+
+        assert len(merged) == 2
+
+    def test_distant_lines_never_merge(self) -> None:
+        """Identical titles far apart in the file stay separate."""
+        first = _issue("src/App.java", 10, "Mutable DTO should be record")
+        second = _issue("src/App.java", 200, "Mutable DTO should be record")
+
+        merged = dedupe_issues([first, second])
+
+        assert len(merged) == 2
+
+    def test_different_files_never_merge(self) -> None:
+        """Same title in different files stays separate."""
+        first = _issue("src/A.java", 5, "Request DTO should be record")
+        second = _issue("src/B.java", 5, "Request DTO should be record")
+
+        merged = dedupe_issues([first, second])
+
+        assert len(merged) == 2
+
+    def test_merge_keeps_higher_relevance(self) -> None:
+        """Merged issue carries the max relevance of the pair."""
+        low = _issue("pom.xml", 21, "Java version below LTS", relevance=2)
+        high = _issue(
+            "pom.xml",
+            21,
+            "Java version below required LTS",
+            reviewer="style-reviewer",
+            relevance=4,
+        )
+
+        merged = dedupe_issues([low, high])
+
+        assert len(merged) == 1
+        assert merged[0].relevance == 4
+
+
+class TestRelevanceFilter:
+    """Tests for orchestrator relevance filtering after dedup."""
+
+    def test_filters_below_threshold_by_default(self) -> None:
+        """Default min_relevance=3 drops relevance 1-2 issues."""
+        orchestrator = Orchestrator()
+        issues = [
+            _issue("src/A.java", 1, "Real security defect", relevance=5),
+            _issue("src/B.java", 1, "Concrete improvement", relevance=3),
+            _issue(
+                "src/C.java",
+                1,
+                "Exception constructor lacks direct unit test",
+                relevance=1,
+            ),
+        ]
+
+        result = orchestrator._consolidate_results(issues)
+
+        assert result.summary.total == 2
+        assert len(result.filtered_issues) == 1
+        assert result.filtered_issues[0].filtered is True
+
+    def test_threshold_is_configurable(self) -> None:
+        """min_relevance=1 keeps everything."""
+        orchestrator = Orchestrator()
+        issues = [
+            _issue("src/A.java", 1, "Bureaucratic nit", relevance=1),
+        ]
+
+        result = orchestrator._consolidate_results(issues, min_relevance=1)
+
+        assert result.summary.total == 1
+        assert result.filtered_issues == []
+
+    def test_filtered_issues_not_counted_in_summary(self) -> None:
+        """Summary severity counts exclude filtered issues."""
+        orchestrator = Orchestrator()
+        issues = [
+            _issue("src/A.java", 1, "Real defect", severity="HIGH", relevance=5),
+            _issue(
+                "src/B.java",
+                1,
+                "Theoretical nit",
+                severity="HIGH",
+                relevance=1,
+            ),
+        ]
+
+        result = orchestrator._consolidate_results(issues)
+
+        assert result.summary.high == 1
+        assert result.summary.total == 1
+
+    def test_pipeline_dedupes_before_filtering(self) -> None:
+        """Duplicates merge first; merged relevance decides the filter."""
+        orchestrator = Orchestrator()
+        issues = [
+            _issue("pom.xml", 21, "Java version below LTS", relevance=2),
+            _issue(
+                "pom.xml",
+                21,
+                "Java version below required LTS",
+                reviewer="style-reviewer",
+                relevance=4,
+            ),
+        ]
+
+        result = orchestrator._consolidate_results(issues)
+
+        # Merged into one, max relevance 4 → kept
+        assert result.summary.total == 1
+        assert result.filtered_issues == []

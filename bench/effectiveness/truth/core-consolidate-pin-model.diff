+                    "default": "standard-model",
+                    "default:refiner": "refiner-model",
+                }
+            )
+        )
+        monkeypatch.setattr(sdk, "_MODEL_PINS_CANDIDATES", (pins,))
+        assert (
+            sdk._pin_model(None, custom_default_key="default:refiner")
+            == "refiner-model"
+        )
+
+    def test_custom_default_key_falls_back_to_default(
+        self, tmp_path, monkeypatch
+    ):
+        pins = tmp_path / "model_pins.json"
+        pins.write_text(json.dumps({"default": "standard-model"}))
+        monkeypatch.setattr(sdk, "_MODEL_PINS_CANDIDATES", (pins,))
+        assert (
+            sdk._pin_model(None, custom_default_key="default:missing")

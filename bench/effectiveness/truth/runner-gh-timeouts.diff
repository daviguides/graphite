+def _run_gh(
+    cmd: list[str],
+    run_env: dict[str, str] | None,
+    timeout: float = _GH_TIMEOUT_S,
+) -> subprocess.CompletedProcess:
+    """Run a gh command with auth env and a timeout.
+
+    A timeout comes back as a failed CompletedProcess whose stderr says
+    "timed out", so callers classify it like any network failure
+    instead of handling a second exception type.
+    """
+    try:
+        return subprocess.run(
+            cmd,
+            env=run_env,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        return subprocess.CompletedProcess(
+            cmd, 124, stdout="",
+            stderr=f"gh timed out after {timeout:.0f}s",
+        )
+
 

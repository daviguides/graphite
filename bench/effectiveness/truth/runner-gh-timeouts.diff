+# Every gh call is bounded: a stuck gh would otherwise hold the whole
+# sequential milestone. Merge gets longer because GitHub may run
+# mergeability checks inline.
+_GH_TIMEOUT_S = 30
+_GH_MERGE_TIMEOUT_S = 60

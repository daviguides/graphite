diff --git a/tools/orch/runner/tests/test_gh_hygiene.py b/tools/orch/runner/tests/test_gh_hygiene.py
new file mode 100644
index 0000000..ea0257a
--- /dev/null
+++ b/tools/orch/runner/tests/test_gh_hygiene.py
@@ -0,0 +1,103 @@
+"""Every gh subprocess carries auth env and a timeout (WS1-T10, R06)."""
+
+import ast
+import subprocess
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from runner.core import hooks
+
+CORE = Path(hooks.__file__).parent
+FILES = [CORE / "hooks.py", CORE / "state.py"]
+
+
+def _is_gh_command(node: ast.AST, source: str) -> bool:
+    if isinstance(node, ast.List) and node.elts:
+        first = node.elts[0]
+        return isinstance(first, ast.Constant) and first.value == "gh"
+    return False
+
+
+def _gh_subprocess_calls():
+    for path in FILES:
+        source = path.read_text()
+        tree = ast.parse(source)
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+            func = node.func
+            if not (
+                isinstance(func, ast.Attribute)
+                and func.attr == "run"
+                and isinstance(func.value, ast.Name)
+                and func.value.id == "subprocess"
+            ):
+                continue
+            if node.args and _is_gh_command(node.args[0], source):
+                yield path.name, node
+
+
+@pytest.mark.parametrize(
+    "kwarg", ["timeout", "env"],
+)
+def test_every_literal_gh_call_has(kwarg):
+    missing = [
+        f"{name}:{node.lineno}"
+        for name, node in _gh_subprocess_calls()
+        if kwarg not in {k.arg for k in node.keywords}
+    ]
+    assert missing == [], f"gh subprocess without {kwarg}= at {missing}"
+
+
+def test_run_gh_timeout_classifies_as_auth_or_network():
+    with patch.object(
+        hooks.subprocess, "run",
+        side_effect=subprocess.TimeoutExpired(cmd=["gh"], timeout=30),
+    ):
+        result = hooks._run_gh(["gh", "pr", "view", "1"], {}, timeout=30)
+    assert result.returncode != 0
+    assert hooks._classify_merge_failure(result.stderr) == "auth_or_network"
+
+
+def test_merge_ladder_uses_long_timeout():
+    calls = []
+
+    def fake_run(cmd, **kwargs):
+        calls.append(kwargs.get("timeout"))
+        return MagicMock(returncode=0, stdout="", stderr="")
+
+    with patch.object(hooks.subprocess, "run", side_effect=fake_run):
+        label, _ = hooks._merge_with_retries(
+            ["gh", "pr", "merge", "1", "--squash"], {},
+        )
+    assert label is not None
+    assert calls and all(t == hooks._GH_MERGE_TIMEOUT_S for t in calls)
+
+
+def test_pr_is_merged_passes_auth_env(tmp_path):
+    from runner.core import state
+
+    yaml_path = tmp_path / "task.yaml"
+    yaml_path.write_text("pr: 7\nstatus: in_progress\n")
+    seen = {}
+
+    def fake_run(cmd, **kwargs):
+        seen.update(kwargs)
+        return MagicMock(returncode=0, stdout="MERGED\n", stderr="")
+
+    with (
+        patch(
+            "dao_cli.core.project.resolve_task_yaml_path",
+            return_value=yaml_path,
+        ),
+        patch.object(state, "find_worktree_path", return_value=tmp_path),
+        patch.object(
+            state, "resolve_auth_env", return_value={"GH_TOKEN": "t"},
+        ),
+        patch.object(state.subprocess, "run", side_effect=fake_run),
+    ):
+        assert state._pr_is_merged("t1") is True
+    assert seen["env"]["GH_TOKEN"] == "t"
+    assert seen["timeout"]

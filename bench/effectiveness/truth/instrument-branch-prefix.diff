 # already spells it too.
 STANDALONE = "standalone"
 
+# What a derived umbrella is called when the project never said.
+# Every project resolving today resolves through this, so it is the
+# one value that must not change.
+DEFAULT_BRANCH_PREFIX = "feature/"
+
+# The `git check-ref-format` rules a prefix can plausibly break, in the
+# one place a composed name is checked. Control characters and space
+# (\x00-\x20), the characters git reserves for revision syntax, `..`,
+# `@{`, and an empty path component.
+_INVALID_REF_RE = re.compile(r"[\x00-\x20~^:?*\[\\\x7f]|\.\.|@\{|//")
+
+
+def _normalise_branch_prefix(prefix: str | None) -> str:
+    """A prefix ending in exactly one `/`, or the default.
+
+    The operator writes this by hand in `registry.yaml` and will write
+    it both ways — `feat` and `feat/` mean the same thing to a person,
+    and only one of them concatenates. Normalising here, once, is why
+    neither `feat//x` nor `featx` can be derived downstream.
+
+    Empty and absent are the same answer, `feature/`. An explicit `""`
+    could be read as "no prefix, bare slug", but a bare `<initiative>`
+    branch sits in the same namespace as the task branches and would
+    read as one; a project that wants that can say so with a prefix.
+    """
+    cleaned = (prefix or "").strip()
+    if not cleaned:
+        return DEFAULT_BRANCH_PREFIX
+    return cleaned.rstrip("/") + "/"
+
+
+def _assert_valid_ref(branch: str, prefix: str) -> None:
+    """Refuse a derived name git would reject, before anything uses it.
+
+    The failure this prevents is not a failed push — it is an approved
+    one. `regent`'s outward gate prints the umbrella on the card the
+    operator authorises, so a name git will not accept gets approved
+    first and fails second, after the human has already said yes to it.
+    An early error costs a re-run; that costs the operator's trust in
+    what the card says.
+
+    Args:
+        branch: The composed branch name.
+        prefix: The prefix it came from, for the message — the
+            initiative slug is generated kebab-case, so the prefix is
+            what a person actually mistyped.
+
+    Raises:
+        SetupError: If the name is not a valid git ref.
+    """
+    invalid = (
+        _INVALID_REF_RE.search(branch)
+        or branch.startswith("/")
+        or branch.endswith((".", "/", ".lock"))
+        or any(
+            part.startswith(".") or part.endswith(".lock")
+            for part in branch.split("/")
+        )
+    )
+    if invalid:
+        raise SetupError(
+            f"Branch prefix {prefix!r} derives {branch!r}, which is not "
+            "a valid git branch name.\n"
+            "Fix `branch_prefix` on this project's entry in "
+            "~/work/projects/data/registry.yaml."
+        )
+
 

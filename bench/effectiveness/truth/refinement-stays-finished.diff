-    # the effect, and close() waits for the process that made it.
+    if not _wait_for_complete(project_dir, session_name):
+        raise EscalationRequiredError(
+            f"{session_name} did not reach COMPLETE within "
+            f"{_COMPLETE_TIMEOUT:.0f}s of the transition — its briefs are "
+            "written, but nothing marked the refinement finished.",
+            stage="refiner",
+            step="egest_complete",
+        )
     return turns
 
 
+def _wait_for_complete(
+    project_dir: Path, session_name: str, timeout: float = _COMPLETE_TIMEOUT
+) -> bool:
+    """Poll session.yaml until the closing transition shows up.
+
+    Polling rather than listening: `/phase` is consumed by the engine
+    without a query, so it emits no turn to wait on, and the file IS the
+    effect. Returning before it lands would let close() send EOF into a
+    transition still in flight.
+
+    Args:
+        project_dir: Project directory.
+        session_name: Refinery session name.
+        timeout: Seconds to wait before giving up.
+
+    Returns:
+        True once the session records COMPLETE.
+    """
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if _current_phase(project_dir, session_name) == "COMPLETE":
+            return True
+        time.sleep(0.5)
+    return _current_phase(project_dir, session_name) == "COMPLETE"
+

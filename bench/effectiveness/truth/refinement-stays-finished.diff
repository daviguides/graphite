@@ -0,0 +1,53 @@
+"""A finished refinement stays finished.
+
+EGEST → COMPLETE is the only transition that writes `status: complete`,
+and every exit path runs _handle_stop immediately after it — a driver
+closing stdin, the app killing the child on the transition event, a human
+typing /stop. pause_session downgraded that terminal state seconds after
+it was reached, so a session with its briefs written read as `paused`,
+and every consumer keyed on `complete` (the stage chip, regent's terminal
+gate) waited forever on work that was already done.
+"""
+
+from pathlib import Path
+
+import pytest
+
+from refiner.core.models import Phase, SessionStatus
+from refiner.core.state import (
+    create_session,
+    load_session,
+    pause_session,
+    transition_phase,
+)
+
+
+@pytest.fixture
+def session(tmp_path: Path) -> tuple[Path, str]:
+    """A project dir with a session sitting in EGEST."""
+    name = "refinery-test"
+    create_session(tmp_path, name, demand_signal={"raw": "x"})
+    transition_phase(tmp_path, name, Phase.EGEST)
+    return tmp_path, name
+
+
+class TestPauseDoesNotDowngradeComplete:
+    def test_complete_survives_a_pause(self, session):
+        project_dir, name = session
+        transition_phase(project_dir, name, Phase.COMPLETE)
+        assert (
+            load_session(project_dir, name).status == SessionStatus.COMPLETE
+        )
+
+        pause_session(project_dir, name)
+
+        data = load_session(project_dir, name)
+        assert data.status == SessionStatus.COMPLETE
+        assert data.phase == Phase.COMPLETE
+
+    def test_an_unfinished_session_still_pauses(self, session):
+        project_dir, name = session
+        pause_session(project_dir, name)
+        data = load_session(project_dir, name)
+        assert data.status == SessionStatus.PAUSED
+        assert data.phase == Phase.EGEST

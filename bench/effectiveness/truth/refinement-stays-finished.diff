+def refiner_session_complete(project_dir: Path, session_name: str) -> bool:
+    """Check whether the refinement actually closed.
+
+    The terminal step's gate cannot be "briefs exist": the briefs land
+    inside the turn that the PREVIOUS segment's transition message
+    provokes, so by the time this step is reached they are already on
+    disk. Gating on them skipped the step that sends the closing
+    transition, and the session sat in EGEST/paused forever with its work
+    finished — EGEST → COMPLETE is the only thing that writes
+    `status: complete`, which is what a reader (a chip, a later run)
+    takes as "the refinery is done with this signal".
+
+    Both halves are required: a session marked complete with no briefs is
+    not done, it is empty.
+
+    Args:
+        project_dir: Project directory.
+        session_name: Refinery session name.
+
+    Returns:
+        True if session.yaml says complete AND briefs.yaml has entries.
+    """
+    if not session_exists(project_dir, session_name):
+        return False
+    session = load_session(project_dir, session_name)
+    if str(session.status or "").lower() != "complete":
+        return False
+    briefs_manifest = (
+        project_dir / "refineries" / session_name / "briefs.yaml"
+    )
+    if not briefs_manifest.exists():
+        return False
+    data = load_yaml(path=briefs_manifest)
+    return bool(data.get("briefs"))
+

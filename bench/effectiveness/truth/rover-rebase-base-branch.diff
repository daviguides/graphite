diff --git a/tools/orch/runner/tests/test_pre_hook_rebase.py b/tools/orch/runner/tests/test_pre_hook_rebase.py
new file mode 100644
index 0000000..ad55ac8
--- /dev/null
+++ b/tools/orch/runner/tests/test_pre_hook_rebase.py
@@ -0,0 +1,161 @@
+"""A task rebases onto its umbrella, not onto the default branch.
+
+Rebasing every task onto the repo default is what kept sibling work
+invisible while it was still useful. On 2026-08-12 `t2-2` spent its
+whole exploration recording that `fixture.go` and `testdata/deep_sense/`
+were "NOT on this branch", while `t2-3` had delivered both to the
+umbrella hours before; it read them out of a sibling worktree, the only
+place they existed for it.
+
+These build a real repository rather than asserting on arguments: the
+question is whether the task's tree ends up holding a file only its
+sibling wrote, and no amount of checking which flags git was handed
+answers that.
+"""
+
+import os
+import subprocess
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from runner.core.hooks import pre_hook_rebase
+
+
+def _git(*args: str, cwd: Path) -> subprocess.CompletedProcess:
+    """Run git with a deterministic identity."""
+    env = {
+        **os.environ,
+        "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t",
+        "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t",
+    }
+    return subprocess.run(
+        ["git", *args], cwd=cwd, env=env,
+        capture_output=True, text=True, timeout=30,
+    )
+
+
+@pytest.fixture
+def siblings(tmp_path: Path):
+    """A task branch and an umbrella carrying a sibling's commit.
+
+    master ── base
+                ├── feature/umbrella  ── sibling.txt   (t2-3's work)
+                └── feature/task      ── task.txt      (ours)
+
+    The task branched off master and never saw the umbrella move,
+    which is the shape every task had before this fix.
+    """
+    remote = tmp_path / "remote.git"
+    _git("init", "-q", "--bare", "-b", "master", str(remote), cwd=tmp_path)
+
+    work = tmp_path / "work"
+    _git("clone", "-q", str(remote), str(work), cwd=tmp_path)
+    (work / "base.txt").write_text("base\n")
+    _git("add", "-A", cwd=work)
+    _git("commit", "-qm", "base", cwd=work)
+    _git("push", "-q", "origin", "master", cwd=work)
+
+    # The umbrella, carrying a sibling task's delivery.
+    _git("checkout", "-q", "-b", "feature/umbrella", cwd=work)
+    (work / "sibling.txt").write_text("what t2-3 delivered\n")
+    _git("add", "-A", cwd=work)
+    _git("commit", "-qm", "sibling: the fixture", cwd=work)
+    _git("push", "-q", "-u", "origin", "feature/umbrella", cwd=work)
+
+    # Our task, branched from master — behind the umbrella.
+    _git("checkout", "-q", "master", cwd=work)
+    _git("checkout", "-q", "-b", "feature/task", cwd=work)
+    (work / "task.txt").write_text("our own work\n")
+    _git("add", "-A", cwd=work)
+    _git("commit", "-qm", "task: our commit", cwd=work)
+    _git("push", "-q", "-u", "origin", "feature/task", cwd=work)
+
+    return work
+
+
+@pytest.fixture(autouse=True)
+def _no_gh_auth():
+    """No GitHub in a tmp_path remote — keep the test hermetic."""
+    with patch(
+        "runner.core.hooks.resolve_auth_env", return_value=None,
+    ):
+        yield
+
+
+class TestTaskSeesItsSiblings:
+    """The umbrella's work reaches the task that needs it."""
+
+    def test_the_siblings_commit_arrives(self, siblings: Path):
+        pre_hook_rebase(siblings, base_branch="feature/umbrella")
+
+        assert (siblings / "sibling.txt").is_file(), (
+            "the task rebased and still cannot see what its sibling "
+            "delivered to the umbrella — this is the t2-2 shape"
+        )
+        # And it keeps its own work: a rebase, not a reset.
+        assert (siblings / "task.txt").is_file()
+
+    def test_the_umbrella_becomes_history_not_a_divergence(
+        self, siblings: Path,
+    ):
+        pre_hook_rebase(siblings, base_branch="feature/umbrella")
+
+        # The umbrella is an ancestor now — the task is built ON it,
+        # not beside it. This is the property; a file appearing in
+        # the tree could also come from a merge or a checkout.
+        ancestor = _git(
+            "merge-base", "--is-ancestor",
+            "origin/feature/umbrella", "HEAD", cwd=siblings,
+        )
+        assert ancestor.returncode == 0, (
+            "the umbrella is not in the task's history — the task "
+            "diverges from the work it is supposed to build on"
+        )
+
+        # And our own commit rode over it rather than being replaced.
+        log = _git(
+            "log", "--oneline", "origin/feature/umbrella..HEAD",
+            cwd=siblings,
+        ).stdout
+        assert "task: our commit" in log
+        assert "sibling: the fixture" not in log
+
+
+class TestNoUmbrellaIsUnchanged:
+    """A task with no base_branch behaves exactly as before."""
+
+    def test_default_branch_is_used_and_the_umbrella_is_not(
+        self, siblings: Path,
+    ):
+        pre_hook_rebase(siblings, base_branch=None)
+
+        assert (siblings / "base.txt").is_file()
+        assert not (siblings / "sibling.txt").exists(), (
+            "a task with no umbrella must not be dragged onto one"
+        )
+
+    def test_omitting_the_argument_is_the_old_behaviour(
+        self, siblings: Path,
+    ):
+        # The signature stayed compatible: every existing caller
+        # that passes only cwd keeps its meaning.
+        pre_hook_rebase(siblings)
+
+        assert not (siblings / "sibling.txt").exists()
+
+
+class TestFailureIsNamed:
+    """A skipped rebase says which base it could not reach."""
+
+    def test_the_warning_names_the_umbrella(
+        self, siblings: Path, capsys,
+    ):
+        pre_hook_rebase(siblings, base_branch="feature/does-not-exist")
+
+        out = capsys.readouterr().out
+        assert "feature/does-not-exist" in out, (
+            "'Rebase skipped' alone cannot tell a task that missed "
+            "its umbrella from one that missed the default branch"
+        )

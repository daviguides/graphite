diff --git a/tools/orch/runner/tests/test_attempt_counters.py b/tools/orch/runner/tests/test_attempt_counters.py
new file mode 100644
index 0000000..2d8224b
--- /dev/null
+++ b/tools/orch/runner/tests/test_attempt_counters.py
@@ -0,0 +1,202 @@
+"""WS2-T2 (B01): retry guards count durable attempts, not the trimmed log.
+
+Session trim keeps two entries per mode; the old FINALIZING guard needed
+three and the fresh-start threshold (15) sat above the trimmed log's
+ceiling. Counted over repeated dispatches the guard saw 0, 1, 2, 2, 2...
+forever. These tests replay repeated dispatches against a dict-backed
+task.yaml with trim active and assert the guards actually fire.
+"""
+
+import asyncio
+import copy
+from contextlib import ExitStack
+from typing import Any
+from unittest.mock import MagicMock, patch
+
+from test_engine_resilience import _single_mode_context
+
+from runner.core.attempts import (
+    record_fresh_start,
+    record_gate_fail,
+    record_gate_pass,
+    record_mode_run,
+    total_attempts,
+)
+from runner.core.engine import run_task
+from runner.core.models import (
+    ExecutionConfig,
+    FinalizeOutcome,
+    FinalizeResult,
+    SessionRecord,
+)
+
+
+class TestCounterSchema:
+    def test_mode_runs_accumulate_and_reset_on_gate_pass(self) -> None:
+        data: dict[str, Any] = {}
+        assert record_mode_run(data, "VALIDATING") == 1
+        assert record_mode_run(data, "VALIDATING") == 2
+        record_gate_pass(data, "VALIDATING", "FINALIZING")
+        assert record_mode_run(data, "VALIDATING") == 1
+        assert total_attempts(data) == 3
+        assert data["attempts"]["lifetime"] == 3
+
+    def test_gate_fail_streak_resets_on_pass(self) -> None:
+        data: dict[str, Any] = {}
+        assert record_gate_fail(data, "A", "B") == 1
+        assert record_gate_fail(data, "A", "B") == 2
+        record_gate_pass(data, "A", "B")
+        assert record_gate_fail(data, "A", "B") == 1
+
+    def test_fresh_start_keeps_lifetime(self) -> None:
+        data: dict[str, Any] = {}
+        for _ in range(4):
+            record_mode_run(data, "EXPLORING")
+        assert record_fresh_start(data) == 1
+        assert total_attempts(data) == 0
+        assert data["attempts"]["lifetime"] == 4
+
+    def test_malformed_block_is_repaired(self) -> None:
+        data: dict[str, Any] = {"attempts": {"total": "x", "modes": []}}
+        assert record_mode_run(data, "M") == 1
+        assert data["attempts"]["total"] == 1
+
+
+class _Disk:
+    def __init__(self, data: dict[str, Any]) -> None:
+        self.data = copy.deepcopy(data)
+
+    def load(self, _task_name: str) -> dict[str, Any]:
+        return copy.deepcopy(self.data)
+
+    def save(self, _task_name: str, data: dict[str, Any]) -> None:
+        self.data = copy.deepcopy(data)
+
+
+BASE = {
+    "workflow": "self-implementation",
+    "branch": "feature/t",
+    "issue": 1,
+    "milestone": "m",
+}
+
+
+def _dispatch(
+    disk: _Disk,
+    modes: list[str],
+    extra: dict[str, dict[str, Any]],
+    gate_passed: bool = True,
+) -> Any:
+    """One queue dispatch of the task: a fresh run_task over `disk`."""
+    transitions = {a: b for a, b in zip(modes, modes[1:])}
+    config = ExecutionConfig(task_name="t", skip_cleanup=True)
+    records = [
+        SessionRecord(mode=m, session_id=f"s-{m}", last_text="ok")
+        for m in modes
+    ]
+    with _single_mode_context(
+        task_data=disk.data,
+        execute_side_effect=records,
+        gate_passed=gate_passed,
+    ), ExitStack() as stack:
+        stack.enter_context(patch(
+            "runner.core.engine.load_task_data", side_effect=disk.load,
+        ))
+        stack.enter_context(patch(
+            "runner.core.engine.save_task_data", side_effect=disk.save,
+        ))
+        stack.enter_context(patch(
+            "runner.core.engine.get_task_mode",
+            side_effect=lambda data: str(data.get("mode")).upper(),
+        ))
+        stack.enter_context(patch(
+            "runner.core.engine.list_workflow_modes", return_value=modes,
+        ))
+        stack.enter_context(patch(
+            "runner.core.engine.get_next_mode",
+            side_effect=lambda workflow, current: transitions.get(current),
+        ))
+        for target, kwargs in extra.items():
+            stack.enter_context(patch(target, **kwargs))
+        return asyncio.run(run_task(config))
+
+
+class TestFinalizingRetryGuardFiresUnderTrim:
+    def test_needs_human_on_fourth_dispatch(self) -> None:
+        disk = _Disk({
+            **BASE,
+            "mode": "FINALIZING",
+            "status": "queued",
+            # Trim is active: more than two entries for the mode.
+            "sessions": [
+                {"mode": "FINALIZING", "timestamp": f"t{i}"}
+                for i in range(3)
+            ],
+        })
+        finalize = MagicMock(return_value=FinalizeOutcome(
+            FinalizeResult.AUTO_QUEUED, "checks pending",
+        ))
+        extra = {"runner.core.engine.execute_finalizing": {"new": finalize}}
+
+        stops = []
+        for _ in range(4):
+            result = _dispatch(disk, ["FINALIZING"], extra)
+            stops.append(result.stopped_reason)
+            assert len(disk.data.get("sessions") or []) <= 2
+
+        assert finalize.call_count == 3
+        assert stops[-1] == "needs_human"
+        assert disk.data["status"] == "needs_human"
+        assert "FINALIZING" in disk.data["blockers"]
+
+
+class TestGateCircuitBreaker:
+    def test_third_consecutive_gate_fail_holds_for_human(self) -> None:
+        disk = _Disk({**BASE, "mode": "EXPLORING", "status": "queued"})
+        statuses = []
+        for _ in range(3):
+            _dispatch(
+                disk, ["EXPLORING", "RESEARCHING"], {}, gate_passed=False,
+            )
+            statuses.append(disk.data["status"])
+
+        assert statuses == ["queued", "queued", "needs_human"]
+        assert "EXPLORING>RESEARCHING" in disk.data["blockers"]
+
+    def test_gate_pass_clears_mode_counter(self) -> None:
+        disk = _Disk({**BASE, "mode": "EXPLORING", "status": "queued"})
+        _dispatch(disk, ["EXPLORING", "RESEARCHING"], {})
+        assert "EXPLORING" not in disk.data["attempts"]["modes"]
+
+
+class TestFreshStartReachable:
+    def test_threshold_resets_to_first_workflow_mode(self) -> None:
+        disk = _Disk({
+            **BASE,
+            "mode": "RESEARCHING",
+            "status": "queued",
+            "sessions": [{"mode": "RESEARCHING", "timestamp": "t"}],
+            "attempts": {"total": 15, "lifetime": 15},
+        })
+        _dispatch(disk, ["EXPLORING", "RESEARCHING"], {})
+
+        attempts = disk.data["attempts"]
+        assert attempts["fresh_starts"] == 1
+        assert attempts["lifetime"] > 15
+        # Reset lands on the workflow's own first mode, not "BRIEFING".
+        assert all(
+            s.get("mode") != "RESEARCHING" or s.get("timestamp") != "t"
+            for s in disk.data.get("sessions") or []
+        )
+
+    def test_second_fresh_start_escalates(self) -> None:
+        disk = _Disk({
+            **BASE,
+            "mode": "EXPLORING",
+            "status": "queued",
+            "attempts": {"total": 15, "lifetime": 40, "fresh_starts": 1},
+        })
+        result = _dispatch(disk, ["EXPLORING"], {})
+
+        assert result.stopped_reason == "needs_human"
+        assert disk.data["status"] == "needs_human"

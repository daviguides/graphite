new file mode 100644
index 0000000..bb2e57e
--- /dev/null
+++ b/tools/orch/runner/runner/core/attempts.py
@@ -0,0 +1,87 @@
+"""Durable attempt counters, kept apart from the trimmed session log.
+
+Session protection trims `sessions` to the last few per mode so the
+prompt and task.yaml stop growing. Every retry guard used to count that
+same trimmed list, so a guard that needed three attempts could never
+see more than two, and the fresh-start threshold sat above the list's
+maximum size. These counters are the evidence the guards read, and
+nothing trims them.
+
+Schema in task.yaml:
+
+    attempts:
+      total: 7          # mode runs since the last fresh start
+      lifetime: 22      # mode runs ever; never reset
+      fresh_starts: 1
+      modes: {VALIDATING: 2}    # runs since that mode's gate passed
+      gate_fails: {"VALIDATING>FINALIZING": 2}  # consecutive fails
+"""
+
+from typing import Any
+
+ATTEMPTS_KEY = "attempts"
+
+
+def _block(data: dict[str, Any]) -> dict[str, Any]:
+    raw = data.get(ATTEMPTS_KEY)
+    block: dict[str, Any] = dict(raw) if isinstance(raw, dict) else {}
+    for key in ("total", "lifetime", "fresh_starts"):
+        value = block.get(key)
+        block[key] = value if isinstance(value, int) else 0
+    for key in ("modes", "gate_fails"):
+        value = block.get(key)
+        block[key] = dict(value) if isinstance(value, dict) else {}
+    data[ATTEMPTS_KEY] = block
+    return block
+
+
+def transition_key(mode: str, next_mode: str) -> str:
+    return f"{mode}>{next_mode}"
+
+
+def total_attempts(data: dict[str, Any]) -> int:
+    return _block(data)["total"]
+
+
+def record_mode_run(data: dict[str, Any], mode: str) -> int:
+    """Count one run of `mode`; return its runs since its gate last passed."""
+    block = _block(data)
+    block["total"] += 1
+    block["lifetime"] += 1
+    block["modes"][mode] = block["modes"].get(mode, 0) + 1
+    return block["modes"][mode]
+
+
+def record_gate_pass(data: dict[str, Any], mode: str, next_mode: str) -> None:
+    block = _block(data)
+    block["modes"].pop(mode, None)
+    block["gate_fails"].pop(transition_key(mode, next_mode), None)
+
+
+def record_gate_fail(data: dict[str, Any], mode: str, next_mode: str) -> int:
+    """Count one failure of the gate `mode`→`next_mode`; return the streak."""
+    block = _block(data)
+    key = transition_key(mode, next_mode)
+    block["gate_fails"][key] = block["gate_fails"].get(key, 0) + 1
+    return block["gate_fails"][key]
+
+
+def record_fresh_start(data: dict[str, Any]) -> int:
+    """Reset per-generation counters; return fresh starts so far."""
+    block = _block(data)
+    block["total"] = 0
+    block["modes"] = {}
+    block["gate_fails"] = {}
+    block["fresh_starts"] += 1
+    return block["fresh_starts"]
+
+
+__all__ = [
+    "ATTEMPTS_KEY",
+    "record_fresh_start",
+    "record_gate_fail",
+    "record_gate_pass",
+    "record_mode_run",
+    "total_attempts",
+    "transition_key",
+]

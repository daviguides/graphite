diff --git a/tools/orch/foreman/tests/test_validating_reject_route_back.py b/tools/orch/foreman/tests/test_validating_reject_route_back.py
new file mode 100644
index 00000000..6908036b
--- /dev/null
+++ b/tools/orch/foreman/tests/test_validating_reject_route_back.py
@@ -0,0 +1,279 @@
+"""Tests for the structured VALIDATING-reject route-back to
+IMPLEMENTING, and the general gate-recheck-before-advance fix.
+
+Two related gaps in resume-mode resolution (`run_task` in
+engine.py), both stemming from the same root cause: a session
+entry for a mode means it was ATTEMPTED, not that its gate to the
+next mode actually passed.
+
+1. No route-back: when VALIDATING's own SDK session concludes the
+   implementation isn't actually done, it had no structured way to
+   say so — only free prose in `last_action`/`next_steps`, which
+   the resume logic doesn't (and shouldn't) parse to decide control
+   flow. A new `validation_verdict`/`rejection_reason` pair (set via
+   `dao task update`, same mechanism as `last_action`/`next_steps`)
+   gives it one.
+
+2. Skip-ahead: resume blindly advanced to `next_from_stored` on any
+   session entry, with no re-check that the gate to that next mode
+   actually passes. A task whose VALIDATING attempt failed its gate
+   to FINALIZING (checkboxes unmarked) would, on the very next
+   dispatch, resolve `current_mode = "FINALIZING"` directly and
+   attempt a real merge — skipping a phase that was never delivered.
+"""
+
+import asyncio
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from foreman.core.engine import run_task
+from foreman.core.models import ExecutionConfig, SessionRecord
+
+
+def _make_fake_sdk(record: SessionRecord) -> AsyncMock:
+    sdk = AsyncMock()
+    sdk.execute = AsyncMock(return_value=record)
+    sdk.is_connected = True
+    sdk.session_id = "fake-session"
+    sdk.send_pause = AsyncMock()
+    sdk.disconnect = AsyncMock()
+    return sdk
+
+
+@contextmanager
+def _resume_context(
+    *,
+    task_data: dict[str, Any],
+    workflow_modes: list[str],
+    gate_passed: bool = True,
+    executed_mode: str = "IMPLEMENTING",
+):
+    """Mock everything run_task needs except resume-mode resolution
+    (the code under test). The SDK session immediately errors out
+    right after mode resolution so the test only observes WHICH
+    mode was chosen to run, not a full mode execution."""
+    record = SessionRecord(
+        mode=executed_mode,
+        session_id="fake-session",
+        last_text="ok",
+    )
+    fake_sdk = _make_fake_sdk(record)
+    mock_cleanup = MagicMock(return_value=True)
+
+    def _next_mode(workflow: str, current: str) -> str | None:
+        idx = workflow_modes.index(current)
+        return (
+            workflow_modes[idx + 1]
+            if idx + 1 < len(workflow_modes)
+            else None
+        )
+
+    patches = {
+        "load_task_data": patch(
+            "foreman.core.engine.load_task_data",
+            return_value=task_data.copy(),
+        ),
+        "save_task_data": patch(
+            "foreman.core.engine.save_task_data",
+        ),
+        "get_worktree_path": patch(
+            "foreman.core.engine.get_worktree_path",
+            return_value=Path("/fake/wt"),
+        ),
+        "get_task_mode": patch(
+            "foreman.core.engine.get_task_mode",
+            return_value=task_data["mode"],
+        ),
+        "get_task_workflow": patch(
+            "foreman.core.engine.get_task_workflow",
+            return_value="self-implementation",
+        ),
+        "list_workflow_modes": patch(
+            "foreman.core.engine.list_workflow_modes",
+            return_value=workflow_modes,
+        ),
+        "get_next_mode": patch(
+            "foreman.core.engine.get_next_mode",
+            side_effect=_next_mode,
+        ),
+        "resolve_task_docs_dir": patch(
+            "foreman.core.engine.resolve_task_docs_dir",
+            return_value=Path("/fake/docs"),
+        ),
+        "resolve_plugins": patch(
+            "foreman.core.engine.resolve_plugins_for_mode",
+            return_value=[],
+        ),
+        "compile_plugins": patch(
+            "foreman.core.engine.compile_plugins_for_mode",
+            return_value=(None, []),
+        ),
+        "compose_prompt": patch(
+            "foreman.core.engine.compose_prompt",
+            return_value="# Prompt",
+        ),
+        "compute_gate_result": patch(
+            "foreman.core.engine.compute_gate_result",
+            return_value={"passed": True, "checks": []},
+        ),
+        "print_resume": patch(
+            "foreman.core.engine.print_task_resume_rich",
+        ),
+        "pre_hook_rebase": patch(
+            "foreman.core.engine.pre_hook_rebase",
+        ),
+        "pre_hook_validation": patch(
+            "foreman.core.engine.pre_hook_validation",
+            return_value={},
+        ),
+        "post_hook_dao": patch(
+            "foreman.core.engine.post_hook_dao_update",
+        ),
+        "post_hook_milestone": patch(
+            "foreman.core.engine.post_hook_milestone_update",
+        ),
+        "post_hook_push": patch(
+            "foreman.core.engine.post_hook_commit_and_push",
+            return_value="clean",
+        ),
+        "sdk_wrapper": patch(
+            "foreman.core.engine.SDKWrapper",
+            return_value=fake_sdk,
+        ),
+        "cleanup": patch(
+            "foreman.core.engine.cleanup_worktree",
+            mock_cleanup,
+        ),
+        # First call: resume-block gate re-check (code under test).
+        # Second call (if reached): post-mode gate check for the
+        # NEXT mode after this run's mode executes.
+        "do_gate_check": patch(
+            "foreman.core.engine.do_gate_check",
+            return_value={"passed": gate_passed, "checks": []},
+        ),
+        "create_emitter": patch(
+            "foreman.core.engine.create_emitter",
+            return_value=MagicMock(
+                active=False, emit=MagicMock(),
+            ),
+        ),
+        "do_transition": patch(
+            "foreman.core.engine.do_transition",
+            side_effect=lambda task_data, new_mode: {
+                **task_data, "mode": new_mode,
+            },
+        ),
+    }
+
+    entered = {}
+    try:
+        for name, p in patches.items():
+            entered[name] = p.__enter__()
+        yield entered
+    finally:
+        for p in reversed(list(patches.values())):
+            p.__exit__(None, None, None)
+
+
+class TestValidatingRejectRoutesBackToImplementing:
+    """Structured validation_verdict: rejected → IMPLEMENTING."""
+
+    def test_rejected_verdict_routes_to_implementing(self) -> None:
+        config = ExecutionConfig(task_name="regent-dogfood-validation")
+        task_data = {
+            "workflow": "self-implementation",
+            "mode": "VALIDATING",
+            "status": "in_progress",
+            "validation_verdict": "rejected",
+            "rejection_reason": "steps 5-13 of the dogfood run "
+            "were never actually executed",
+            "sessions": [{"mode": "VALIDATING", "session_id": "s1"}],
+        }
+
+        with _resume_context(
+            task_data=task_data,
+            workflow_modes=["IMPLEMENTING", "VALIDATING", "FINALIZING"],
+            executed_mode="IMPLEMENTING",
+        ) as ctx:
+            result = asyncio.run(run_task(config))
+
+        # Routed straight to IMPLEMENTING for THIS resume decision —
+        # not the (correct) later gate check for IMPLEMENTING's own
+        # next transition, which still happens normally.
+        assert result.modes_executed == ["IMPLEMENTING"]
+
+    def test_approved_verdict_advances_normally(self) -> None:
+        """Regression: an approved (or absent) verdict doesn't
+        trip the reject path — normal gate-checked advance."""
+        config = ExecutionConfig(task_name="regent-dogfood-validation")
+        task_data = {
+            "workflow": "self-implementation",
+            "mode": "VALIDATING",
+            "status": "in_progress",
+            "validation_verdict": "approved",
+            "sessions": [{"mode": "VALIDATING", "session_id": "s1"}],
+        }
+
+        with _resume_context(
+            task_data=task_data,
+            workflow_modes=["VALIDATING", "FINALIZING"],
+            gate_passed=True,
+            executed_mode="FINALIZING",
+        ) as ctx:
+            result = asyncio.run(run_task(config))
+
+        assert result.modes_executed == ["FINALIZING"]
+        ctx["do_gate_check"].assert_called()
+
+
+class TestGateRecheckBeforeAdvance:
+    """Resume must not skip a phase whose gate never actually
+    passed, even without an explicit rejected verdict (e.g. a gate
+    failure with no structured signal at all)."""
+
+    def test_failed_gate_reruns_stored_mode_instead_of_skipping(
+        self,
+    ) -> None:
+        config = ExecutionConfig(task_name="regent-dogfood-validation")
+        task_data = {
+            "workflow": "self-implementation",
+            "mode": "VALIDATING",
+            "status": "in_progress",
+            "sessions": [{"mode": "VALIDATING", "session_id": "s1"}],
+        }
+
+        with _resume_context(
+            task_data=task_data,
+            workflow_modes=["VALIDATING", "FINALIZING"],
+            gate_passed=False,
+            executed_mode="VALIDATING",
+        ) as ctx:
+            result = asyncio.run(run_task(config))
+
+        # Must re-run VALIDATING, NOT skip ahead into FINALIZING —
+        # the gate to FINALIZING was rechecked and failed.
+        assert result.modes_executed == ["VALIDATING"]
+        ctx["do_gate_check"].assert_called()
+
+    def test_passed_gate_advances_normally(self) -> None:
+        """Regression: unrelated intermediate-mode advance with a
+        genuinely passing gate is unaffected."""
+        config = ExecutionConfig(task_name="some-task")
+        task_data = {
+            "workflow": "self-implementation",
+            "mode": "EXPLORING",
+            "status": "in_progress",
+            "sessions": [{"mode": "EXPLORING", "session_id": "s1"}],
+        }
+
+        with _resume_context(
+            task_data=task_data,
+            workflow_modes=["EXPLORING", "RESEARCHING"],
+            gate_passed=True,
+            executed_mode="RESEARCHING",
+        ) as ctx:
+            result = asyncio.run(run_task(config))
+
+        assert result.modes_executed == ["RESEARCHING"]

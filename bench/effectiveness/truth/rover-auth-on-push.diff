diff --git a/tools/flow/rover/tests/test_batch_committer.py b/tools/flow/rover/tests/test_batch_committer.py
new file mode 100644
index 0000000..bcf5c8a
--- /dev/null
+++ b/tools/flow/rover/tests/test_batch_committer.py
@@ -0,0 +1,217 @@
+"""Tests for batch_committer auth env threading."""
+
+from datetime import UTC, datetime
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+from rover.commit.services.batch_committer import batch_commit
+from rover.core.schemas.config import RepoCache, RepoEntry, RoverConfig
+
+AUTH_CONFIG = RoverConfig(
+    owners=["daviguides", "bespinus"],
+    auth={
+        "daviguides": "daviguides",
+        "bespinus": "davi-andrade-bespin",
+    },
+)
+
+
+def _make_cache(
+    repos: list[tuple[Path, str | None]],
+) -> RepoCache:
+    """Build a RepoCache from (path, owner) pairs."""
+    return RepoCache(
+        root=repos[0][0].parent if repos else Path("/tmp"),
+        updated_at=datetime.now(tz=UTC),
+        repos=[
+            RepoEntry(name=p.name, path=p, owner=owner)
+            for p, owner in repos
+        ],
+    )
+
+
+class TestBatchCommitAuthEnv:
+    """Verify auth env is resolved per repo and threaded to push."""
+
+    def test_push_receives_resolved_env(
+        self, tmp_path: Path,
+    ) -> None:
+        repo_a = tmp_path / "repo-a"
+        repo_a.mkdir()
+        token_env = {"GITHUB_TOKEN": "ghp_bespin123"}
+
+        cache = _make_cache([(repo_a, "bespinus")])
+
+        mock_push = MagicMock()
+
+        with (
+            patch(
+                "rover.commit.services.batch_committer.load_config",
+                return_value=AUTH_CONFIG,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.load_cache",
+                return_value=cache,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.resolve_auth_env",
+                return_value=token_env,
+            ) as mock_resolve,
+            patch(
+                "rover.commit.services.batch_committer.generate_message",
+            ) as mock_gen,
+            patch(
+                "rover.commit.services.batch_committer.execute_commit",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.push",
+                mock_push,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_commit_panel",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_info",
+            ),
+        ):
+            mock_gen.return_value.format.return_value = "msg"
+            report = batch_commit([repo_a])
+
+        assert report.results[0].status == "committed"
+        mock_resolve.assert_called_once_with("bespinus", AUTH_CONFIG)
+        mock_push.assert_called_once_with(env=token_env)
+
+    def test_push_receives_none_for_no_owner(
+        self, tmp_path: Path,
+    ) -> None:
+        repo_a = tmp_path / "repo-a"
+        repo_a.mkdir()
+
+        cache = _make_cache([(repo_a, None)])
+
+        mock_push = MagicMock()
+
+        with (
+            patch(
+                "rover.commit.services.batch_committer.load_config",
+                return_value=AUTH_CONFIG,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.load_cache",
+                return_value=cache,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.resolve_auth_env",
+                return_value=None,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.generate_message",
+            ) as mock_gen,
+            patch(
+                "rover.commit.services.batch_committer.execute_commit",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.push",
+                mock_push,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_commit_panel",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_info",
+            ),
+        ):
+            mock_gen.return_value.format.return_value = "msg"
+            batch_commit([repo_a])
+
+        mock_push.assert_called_once_with(env=None)
+
+    def test_no_push_skips_auth_resolution_call(
+        self, tmp_path: Path,
+    ) -> None:
+        repo_a = tmp_path / "repo-a"
+        repo_a.mkdir()
+
+        cache = _make_cache([(repo_a, "bespinus")])
+
+        mock_push = MagicMock()
+
+        with (
+            patch(
+                "rover.commit.services.batch_committer.load_config",
+                return_value=AUTH_CONFIG,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.load_cache",
+                return_value=cache,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.resolve_auth_env",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.generate_message",
+            ) as mock_gen,
+            patch(
+                "rover.commit.services.batch_committer.execute_commit",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.push",
+                mock_push,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_commit_panel",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_info",
+            ),
+        ):
+            mock_gen.return_value.format.return_value = "msg"
+            batch_commit([repo_a], no_push=True)
+
+        mock_push.assert_not_called()
+
+    def test_missing_cache_graceful(
+        self, tmp_path: Path,
+    ) -> None:
+        """No cache → owner_index empty → env=None."""
+        repo_a = tmp_path / "repo-a"
+        repo_a.mkdir()
+
+        mock_push = MagicMock()
+
+        with (
+            patch(
+                "rover.commit.services.batch_committer.load_config",
+                return_value=AUTH_CONFIG,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.load_cache",
+                side_effect=FileNotFoundError,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.resolve_auth_env",
+                return_value=None,
+            ) as mock_resolve,
+            patch(
+                "rover.commit.services.batch_committer.generate_message",
+            ) as mock_gen,
+            patch(
+                "rover.commit.services.batch_committer.execute_commit",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.push",
+                mock_push,
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_commit_panel",
+            ),
+            patch(
+                "rover.commit.services.batch_committer.print_info",
+            ),
+        ):
+            mock_gen.return_value.format.return_value = "msg"
+            report = batch_commit([repo_a])
+
+        assert report.results[0].status == "committed"
+        mock_resolve.assert_called_once_with(None, AUTH_CONFIG)
+        mock_push.assert_called_once_with(env=None)

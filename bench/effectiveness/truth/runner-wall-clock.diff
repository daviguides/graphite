diff --git a/tools/orch/runner/tests/test_wall_clock_instrumentation.py b/tools/orch/runner/tests/test_wall_clock_instrumentation.py
new file mode 100644
index 0000000..0fd360f
--- /dev/null
+++ b/tools/orch/runner/tests/test_wall_clock_instrumentation.py
@@ -0,0 +1,106 @@
+"""Wall-clock instrumentation (Q01): the baseline every speed change is
+measured against. Hook durations, mode wall time (including the
+background-task wait), per-tool duration, and time to first edit."""
+
+import asyncio
+from pathlib import Path
+from unittest.mock import MagicMock
+
+from claude_agent_sdk import (
+    AssistantMessage,
+    ResultMessage,
+    ToolResultBlock,
+    ToolUseBlock,
+    UserMessage,
+)
+from test_engine_resilience import (
+    BASE_TASK_DATA,
+    _single_mode_context,
+    _success_record,
+)
+
+from runner.core.engine import run_task
+from runner.core.models import ExecutionConfig
+from runner.core.sdk_wrapper import SDKWrapper
+
+
+class _Stream:
+    def __init__(self, messages: list[object]) -> None:
+        self._messages = list(messages)
+
+    def __aiter__(self) -> _Stream:
+        return self
+
+    async def __anext__(self) -> object:
+        if not self._messages:
+            raise StopAsyncIteration
+        return self._messages.pop(0)
+
+
+async def _noop(*args: object, **kwargs: object) -> None:
+    return None
+
+
+def _wrapper(emitter: MagicMock, messages: list[object]) -> SDKWrapper:
+    w = SDKWrapper.__new__(SDKWrapper)
+    w._verbose = False
+    w._cwd = Path("/tmp")
+    w._emitter = emitter
+    w._stderr_lines = []
+    w._connected = True
+    w._cumulative_cost = 0.0
+    w._session_id = None
+    w._client = MagicMock()
+    w._client.query = _noop
+    w._client.receive_messages = lambda: _Stream(messages)
+    return w
+
+
+def _events(emitter: MagicMock, kind: str) -> list[dict]:
+    return [c.kwargs for c in emitter.emit.call_args_list if c.args[0] == kind]
+
+
+def test_sdk_records_tool_duration_first_edit_and_wall_time() -> None:
+    emitter = MagicMock()
+    messages = [
+        AssistantMessage(
+            content=[
+                ToolUseBlock(
+                    id="tu1", name="Edit", input={"file_path": "a.py"},
+                ),
+            ],
+            model="m",
+        ),
+        UserMessage(content=[ToolResultBlock(tool_use_id="tu1", content="ok")]),
+        ResultMessage(
+            subtype="result", duration_ms=5, duration_api_ms=5,
+            is_error=False, num_turns=1, session_id="s", total_cost_usd=0.0,
+        ),
+    ]
+    wrapper = _wrapper(emitter, messages)
+    record = asyncio.run(wrapper.execute("p", mode="IMPLEMENTING"))
+
+    [call] = _events(emitter, "tool_call")
+    assert call["tool_use_id"] == "tu1"
+    [result] = _events(emitter, "tool_result")
+    assert result["tool_use_id"] == "tu1"
+    assert result["tool"] == "Edit"
+    assert result["duration_ms"] >= 0
+    assert record.first_edit_ms is not None and record.first_edit_ms >= 0
+    assert record.wall_ms >= 0
+
+
+def test_engine_emits_hook_and_mode_wall_durations() -> None:
+    config = ExecutionConfig(task_name="test-task")
+    with _single_mode_context(
+        task_data=BASE_TASK_DATA,
+        execute_side_effect=[_success_record()],
+    ) as ctx:
+        asyncio.run(run_task(config))
+        emit = ctx["create_emitter"].return_value.emit
+
+    kinds = {c.args[0]: c.kwargs for c in emit.call_args_list}
+    assert kinds["pre_hook_done"]["hook"] == "rebase"
+    assert kinds["pre_hook_done"]["hook_duration_ms"] >= 0
+    assert kinds["post_hooks_done"]["hook_duration_ms"] >= 0
+    assert kinds["mode_complete"]["mode_wall_ms"] >= 0

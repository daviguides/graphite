+class TestEnqueueDefaultsToTheProject:
+    """A CLI flag protects whoever types it; the app types nothing."""
+
+    def _entry(self, auto_enqueue: bool):
+        from dao_cli.core.registry import RegistryEntry
+
+        return RegistryEntry(
+            name="p",
+            repo="o/p",
+            path="",
+            auto_enqueue=auto_enqueue,
+        )
+
+    def test_the_project_can_withhold_the_hand_off(self, tmp_path):
+        with patch(
+            "dao_cli.core.registry.lookup_project",
+            return_value=self._entry(False),
+        ):
+            assert cli._project_auto_enqueue(tmp_path) is False
+
+    def test_a_project_that_never_opted_out_still_enqueues(self, tmp_path):
+        with patch(
+            "dao_cli.core.registry.lookup_project",
+            return_value=self._entry(True),
+        ):
+            assert cli._project_auto_enqueue(tmp_path) is True
+
+    def test_an_unreadable_registry_does_not_withhold(self, tmp_path):
+        """Withholding because a file would not open reads as a dead queue.
+
+        The failure mode this key creates is "nothing is executing", and
+        that must never be reachable by accident — only by someone
+        writing it down.
+        """
+        with patch(
+            "dao_cli.core.registry.lookup_project",
+            side_effect=OSError("no registry"),
+        ):
+            assert cli._project_auto_enqueue(tmp_path) is True

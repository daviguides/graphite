+def _project_auto_enqueue(source_dir: Path) -> bool:
+    """Whether this project lets a finished plan start executing.
+
+    The default lives on the project rather than on the command line
+    because a command-line default only protects the person who
+    remembers to type it — the app spawns `regent run` with no such
+    flag, so a project that must not start executing on its own could
+    not be protected from here.
+
+    Unreadable registry means True: this key withholds a hand-off, and
+    withholding one because a file could not be opened would look
+    exactly like a queue that silently stopped picking work up.
+
+    Args:
+        source_dir: The run's source checkout, which is what dao's
+            registry maps back to a project.
+
+    Returns:
+        The project's `auto_enqueue`, or True when it cannot be read.
+    """
+    try:
+        from dao_cli.core.registry import lookup_project
+
+        return bool(lookup_project(start=source_dir).auto_enqueue)
+    except Exception:
+        return True
+
+

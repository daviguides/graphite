---
import { getCollection } from 'astro:content';

interface Props {
  activeDoc: string;
}

const { activeDoc } = Astro.props;
const docs = await getCollection('docs');
const ordered = [...docs].sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<aside class="hidden md:block w-52 shrink-0 border-r border-border-dim">
  <nav class="sticky top-14 py-8 pl-6 pr-4">
    <span class="eyebrow mb-4 block">Documentation</span>
    <ul class="space-y-1">
      {ordered.map(doc => (
        <li>
          <a
            href={`${base}/docs/${doc.id}`}
            class:list={[
              'block text-[0.8125rem] py-1 no-underline transition-colors',
              doc.id === activeDoc
                ? 'text-accent font-medium'
                : 'text-text-secondary hover:text-text-primary',
            ]}
          >
            {doc.data.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

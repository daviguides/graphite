---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="sticky top-0 z-50 border-b border-border-dim" style="background: rgba(12,12,14,0.85); backdrop-filter: blur(12px);">
  <div class="max-w-7xl mx-auto px-4 md:px-6 h-12 flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2 no-underline hover:no-underline">
      <img src={`${base}/favicon.svg`} alt="" width="20" height="20" class="inline-block" />
      <span class="font-semibold text-text-primary text-sm tracking-tight">Graphite</span>
    </a>
    <nav class="flex items-center gap-6 text-[0.8125rem]">
      <a href={`${base}/docs/architecture`} class="text-text-secondary hover:text-text-primary transition-colors no-underline">Docs</a>
      <a href="https://github.com/daviguides/graphite" class="text-text-secondary hover:text-text-primary transition-colors no-underline" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

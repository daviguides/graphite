---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import '../styles/globals.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface DocLink {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  activeDoc: string;
  headings?: Heading[];
  prev?: DocLink | null;
  next?: DocLink | null;
}

const { title, activeDoc, headings = [], prev = null, next = null } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = `Graphite Documentation — ${title}`;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Graphite Docs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <div class="flex-1 flex relative overflow-x-clip">
      <DocsSidebar activeDoc={activeDoc} />
      <div class="flex-1 min-w-0 px-6 py-10 md:px-12 lg:px-16">
        <article class="prose mx-auto">
          <slot />
        </article>

        {(prev || next) && (
          <nav class="prose mx-auto mt-12 pt-6 border-t border-border-dim flex justify-between gap-4 text-[0.8125rem]">
            <div>
              {prev && (
                <a href={`${base}/docs/${prev.slug}`} class="group inline-flex flex-col no-underline">
                  <span class="text-text-dim text-[0.6875rem] uppercase tracking-wider">Previous</span>
                  <span class="text-text-secondary group-hover:text-text-primary transition-colors">← {prev.title}</span>
                </a>
              )}
            </div>
            <div class="text-right">
              {next && (
                <a href={`${base}/docs/${next.slug}`} class="group inline-flex flex-col no-underline">
                  <span class="text-text-dim text-[0.6875rem] uppercase tracking-wider">Next</span>
                  <span class="text-text-secondary group-hover:text-text-primary transition-colors">{next.title} →</span>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>

      {tocHeadings.length > 1 && (
        <aside class="hidden xl:block w-56 shrink-0 pr-6">
          <nav class="sticky top-14 py-10">
            <span class="eyebrow mb-3 block">On this page</span>
            <ul class="space-y-1.5 border-l border-border-dim">
              {tocHeadings.map(h => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      'block text-[0.75rem] leading-snug text-text-muted hover:text-text-primary transition-colors no-underline',
                      h.depth === 2 ? 'pl-3' : 'pl-6',
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
    <Footer />
  </body>
</html>

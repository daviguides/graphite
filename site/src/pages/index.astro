</div>

<div class="landing-section fade-in getting-started">
  <div class="container">
    <p class="section-label">Get started</p>
    <h2 class="section-title">Three commands</h2>
    <div class="cli-demo">
      <div class="cli-header">
        <span class="cli-dot"></span><span class="cli-dot"></span><span class="cli-dot"></span>
        <span class="cli-title">terminal</span>
      </div>
      <pre class="cli-body" is:raw><span class="cli-comment"># Build from source</span>
<span class="cli-prompt">$</span> <span class="cli-highlight">cargo build --release</span>

<span class="cli-comment"># Start the daemon (indexes your repo immediately)</span>
<span class="cli-prompt">$</span> <span class="cli-highlight">./target/release/graphite-cli daemon</span>

<span class="cli-comment"># See what your current diff will break</span>
<span class="cli-prompt">$</span> <span class="cli-highlight">./target/release/graphite-cli diff-impact</span></pre>
    </div>
  </div>
</div>

</BaseLayout>

<script>
document.documentElement.classList.add('js-ready');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

(function animateGraph() {
  const blastEdges = ['b1','b2','b3','b4','b5','b6'];
  const blastNodes = ['n1','n2','n3','n4','n5','n6'];
  const labels = ['l1','l2','l3','l4','l5','l6'];
  const delays = [0, 0, 400, 400, 400, 400];
  function pulse() {
    blastEdges.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => { el.style.transition = 'opacity 0.4s ease-out'; el.style.opacity = '1'; }, delays[i]);
      setTimeout(() => { el.style.transition = 'opacity 0.8s ease-in'; el.style.opacity = '0'; }, delays[i] + 2000);
    });
    blastNodes.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => { el.style.transition = 'opacity 0.4s ease-out'; el.style.opacity = '0.8'; }, delays[i]);
      setTimeout(() => { el.style.transition = 'opacity 0.8s ease-in'; el.style.opacity = '0'; }, delays[i] + 2000);
    });
    labels.forEach((id, i) => {
      const el = document.getElementById(id);
      if (!el) return;
      setTimeout(() => { el.style.transition = 'opacity 0.4s ease-out'; el.style.opacity = '1'; }, delays[i]);
      setTimeout(() => { el.style.transition = 'opacity 0.8s ease-in'; el.style.opacity = '0'; }, delays[i] + 2000);
    });
  }
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    pulse();
    setInterval(pulse, 4000);
  } else {
    blastEdges.forEach(id => { const el = document.getElementById(id); if (el) el.style.opacity = '1'; });
    blastNodes.forEach(id => { const el = document.getElementById(id); if (el) el.style.opacity = '0.8'; });
    labels.forEach(id => { const el = document.getElementById(id); if (el) el.style.opacity = '1'; });
  }
})();
</script>
